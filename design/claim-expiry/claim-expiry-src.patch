--- a/starpulse/web/src/features/kanban/claimMock.tsx	1969-12-31 17:00:00.000000000 -0700
+++ b/starpulse/web/src/features/kanban/claimMock.tsx	2026-10-24 10:50:39.492705670 -0700
@@ -0,0 +1,116 @@
+/**
+ * Design mockup (TASK-7787): where an In Progress task's claim draws on the kanban. Not served by starpulse.
+ *
+ * `?claim=a|b|c|d|e` picks a placement: a the footer's assignee chip, b a badge on the card's top row, c the card's edge,
+ * d the phase track, e the lane header's unheld count as a filter, with a's chip on the card. `&sim=claim` drains the
+ * first In Progress task's claim to expiry in 40 s; `&few=1` keeps three cards a lane.
+ *
+ * Every time drawn comes from what the `Released` event the claim-TTL sweeper already appends carries: its moment, the
+ * session it released, that session's last renewal and the TTL. A held claim's time left reads the same last renewal
+ * the sweeper reads, so it moves each time the session acts.
+ */
+import type { CSSProperties } from "react";
+import { ago } from "../../shared/clock";
+import { profileColor, shortProfile } from "./Kanban";
+
+const q = typeof location === "undefined" ? new URLSearchParams() : new URLSearchParams(location.search);
+export const CLAIM = q.get("claim") ?? "";
+export const CLAIM_SIM = q.get("sim") === "claim";
+export const FEW = q.get("few") === "1";
+const TTL = 1800, NEAR = 600, T0 = Date.now() / 1000;
+
+/** held: the session and its last renewal; expired: the sweeper's `Released {session, last_renewal, ttl}` at `at`; let go: a hand `Released {}`. */
+export type Claim =
+  | { kind: "held"; session: string; renewed: number; ttl: number }
+  | { kind: "expired"; session: string; at: number; renewed: number; ttl: number }
+  | { kind: "let-go"; at: number };
+
+const hash = (s: string) => [...s].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, 7);
+const EXPIRED_AGO = [7 * 60, 45 * 60, 2 * 3600, 5 * 3600, 26 * 3600, 3 * 86400];
+const NEAR_LEFT = [90, 4 * 60, 8 * 60];
+
+/** The claim a mock In Progress task is in at `now`; a held claim whose renewal is a TTL old expires, as the sweeper does. */
+export function claimOf(task: { id: string; lane: string; assignee: string }, now: number, first: boolean): Claim | null {
+  if (!CLAIM || task.lane !== "in_progress") return null;
+  const h = hash(task.id), session = task.assignee || ["@agent-deep", "@agent-standard", "@agent-fast"][h % 3];
+  let renewed: number;
+  if (CLAIM_SIM && first) renewed = T0 - TTL + 40;
+  else if (!task.assignee || h % 10 < 4) {
+    const at = T0 - EXPIRED_AGO[(h >> 4) % EXPIRED_AGO.length];
+    return { kind: "expired", session, at, renewed: at - TTL - 45, ttl: TTL };
+  } else if (h % 10 === 4) return { kind: "let-go", at: T0 - EXPIRED_AGO[(h >> 4) % EXPIRED_AGO.length] };
+  else if (h % 10 < 7) renewed = T0 - TTL + NEAR_LEFT[(h >> 4) % NEAR_LEFT.length];
+  else renewed = T0 - 60 * (1 + ((h >> 4) % 12));
+  return now - renewed >= TTL ? { kind: "expired", session, at: renewed + TTL, renewed, ttl: TTL } : { kind: "held", session, renewed, ttl: TTL };
+}
+
+export const unheld = (c: Claim | null) => c !== null && c.kind !== "held";
+export const left = (c: Claim, now: number) => (c.kind === "held" ? Math.max(0, c.renewed + c.ttl - now) : 0);
+const near = (c: Claim, now: number) => c.kind === "held" && left(c, now) < NEAR;
+const clock = (t: number) => new Date(t * 1000).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit", timeZoneName: "short" });
+const since = (s: number) => (ago(s) === "now" ? "just now" : `${ago(s)} ago`);
+const mins = (s: number) => (s < 60 ? `${Math.ceil(s)}s` : `${Math.ceil(s / 60)}m`);
+
+/** The hover text every placement shares: the stable facts of the `Released` event, or a held claim's renewal. */
+export function claimTitle(c: Claim, now: number): string {
+  if (c.kind === "expired")
+    return `Claim expired: ${shortProfile(c.session)} renewed nothing for ${c.ttl / 60} min. Released ${clock(c.at)} (${since(now - c.at)}); last renewal ${clock(c.renewed)}. Any session may claim it.`;
+  if (c.kind === "let-go") return `Unheld: released by hand ${clock(c.at)} (${since(now - c.at)}). Any session may claim it.`;
+  return `Held by ${shortProfile(c.session)}: last renewal ${clock(c.renewed)}; the claim expires in ${mins(left(c, now))} unless the session acts.`;
+}
+
+/** a, e: the footer's assignee chip, which an unheld task's empty assignee already reaches. */
+export function WhoChip({ c, now }: { c: Claim; now: number }) {
+  if (c.kind === "held")
+    return (
+      <span className={`who${near(c, now) ? " near" : ""}`} title={claimTitle(c, now)}>
+        <i style={{ background: profileColor(c.session) }} />{shortProfile(c.session)}{near(c, now) && <span className="tl">· {mins(left(c, now))} left</span>}
+      </span>
+    );
+  return (
+    <span className="who unheld" title={claimTitle(c, now)}>
+      {c.kind === "expired" ? <><i className="o" style={{ borderColor: profileColor(c.session) }} /><s>{shortProfile(c.session)}</s><span className="tl">· expired {ago(now - c.at)}</span></> : <><i className="o" />unheld {ago(now - c.at)}</>}
+    </span>
+  );
+}
+
+/** b: a badge on the top row, beside the id and the pull request chip, which a compact card keeps. */
+export function TopBadge({ c, now }: { c: Claim; now: number }) {
+  if (c.kind === "held") return near(c, now) ? <span className="cb near" title={claimTitle(c, now)}>⏱ {mins(left(c, now))}</span> : null;
+  return <span className="cb unheld" title={claimTitle(c, now)}>unheld {ago(now - c.at)}</span>;
+}
+
+/** c: the card's edge. An unheld card's border goes dashed; a held claim drains along its bottom edge. */
+export function edgeClass(c: Claim | null, now: number) {
+  return !c ? "" : c.kind === "held" ? (near(c, now) ? " cl-near" : "") : " cl-unheld";
+}
+export function Drain({ c, now }: { c: Claim; now: number }) {
+  return c.kind === "held" ? <span className={`drain${near(c, now) ? " near" : ""}`} style={{ width: `${(100 * left(c, now)) / c.ttl}%` } as CSSProperties} /> : null;
+}
+
+/** d: the age at the end of the phase track's chain row (or the machine row) says unheld, and the marker goes hollow. */
+export function TrackAge({ c, now, age }: { c: Claim; now: number; age: string }) {
+  if (c.kind === "held") return near(c, now) ? <span className="ago near" title={claimTitle(c, now)}>⏱ {mins(left(c, now))} · {age}</span> : <span className="ago">{age}</span>;
+  return <span className="ago unheld" title={claimTitle(c, now)}>unheld {ago(now - c.at)}</span>;
+}
+
+/** The mock's own switcher: one link per placement and state, so each is a linkable address. */
+export function ClaimBar() {
+  if (!CLAIM) return null;
+  const go = (k: string, v: string | null) => {
+    const p = new URLSearchParams(location.search);
+    if (v === null) p.delete(k);
+    else p.set(k, v);
+    return `?${p}`;
+  };
+  const opts: [string, string][] = [["a", "A · footer chip"], ["b", "B · top badge"], ["c", "C · card edge"], ["d", "D · phase track"], ["e", "E · lane count + filter"]];
+  return (
+    <nav id="claim-bar" aria-label="Claim placement">
+      <span className="lb">Claim placement</span>
+      {opts.map(([v, name]) => <a key={v} href={go("claim", v)} className={CLAIM === v ? "on" : undefined}>{name}</a>)}
+      <span className="sp" />
+      <a href={go("sim", CLAIM_SIM ? "2" : "claim")} className={CLAIM_SIM ? "on" : undefined} title="The first In Progress task's claim has 40 s left; watch it expire">expire one</a>
+      <a href={go("few", FEW ? null : "1")} className={FEW ? "on" : undefined}>near-empty</a>
+    </nav>
+  );
+}
