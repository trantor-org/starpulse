+      const p = along(m.path, m.cum, Math.max(0, head - tail * (1 - (i - 1) / 14))), q = along(m.path, m.cum, Math.max(0, head - tail * (1 - i / 14)));
+      cx.strokeStyle = rgba(col, (i / 14) * 0.6);
+      cx.lineWidth = ((i / 14) * 2.6) / Math.max(1, dc.ZS * 0.8);
+      cx.beginPath();
+      cx.moveTo(p.x, p.y);
+      cx.lineTo(q.x, q.y);
+      cx.stroke();
+    }
+    const gr = 14 / dc.ZS, gl = cx.createRadialGradient(k.x, k.y, 0, k.x, k.y, gr);
+    gl.addColorStop(0, rgba(col, 0.7));
+    gl.addColorStop(1, rgba(col, 0));
+    cx.globalCompositeOperation = "lighter";
+    cx.fillStyle = gl;
+    cx.beginPath();
+    cx.arc(k.x, k.y, gr, 0, TAU);
+    cx.fill();
+    cx.globalCompositeOperation = "source-over";
+  }
+}
+
+/** Mockup only: the line a task rode out to its dot, from the sun's hub through its phase's stations and the sub-machine's, for the back-trace.
+ * Each point carries the colour of the place it belongs to (the sun at the hub, else its machine's), as a state route's ends do. */
+export function trailOf(id: string, sc: Scene): { pts: (Pt & { c: string })[]; stations: (Pt & { c: string })[] } | null {
+  const m = mems.get(id);
+  if (!m || m.node.startsWith("orbit:") || m.route.length < 2) return null;
+  // cut the route at the dot, which is mid-glide on it or sat on its last node
+  let best = Infinity, cut = m.route.length - 1, at: Pt = m.route[cut];
+  for (let i = 1; i < m.route.length; i++) {
+    const a = m.route[i - 1], b = m.route[i], dx = b.x - a.x, dy = b.y - a.y, l = dx * dx + dy * dy;
+    const u = l ? Math.max(0, Math.min(1, ((m.x - a.x) * dx + (m.y - a.y) * dy) / l)) : 0;
+    const q = { x: a.x + dx * u, y: a.y + dy * u }, d = Math.hypot(q.x - m.x, q.y - m.y);
+    if (d < best - 0.5) [best, cut, at] = [d, i - 1, q];
+  }
+  let c = "#94a3b8";
+  // a place being placed afresh has no position yet, so its nodes drop out of the trail until it has one
+  const run = m.route.slice(0, cut + 1).filter((n) => Number.isFinite(n.x) && Number.isFinite(n.y)).map((n) => {
+    const b = branches.get(n.k.slice(0, n.k.lastIndexOf(":")));
+    if (b) c = n.k.endsWith(":h") ? sc.galaxies[b.sun]?.color ?? c : kind(b);
+    return { ...n, c };
+  });
+  // the leg from one place's last station to the next place's first is shaded across its whole length from one colour to the other, as a
+  // flow line is from star to star; a station keeps its own machine's colour
+  const pts = [...run, { ...at, c }], cum = lengths(pts), isStation = (p: Pt) => "k" in p && /:\d+$/.test(String(p.k));
+  const bled = [...pts];
+  for (let j = 1; j < pts.length; j++) {
+    if (pts[j].c === pts[j - 1].c) continue;
+    const from = pts.slice(0, j).findLastIndex(isStation), to = pts.findIndex((p, i) => i >= j && isStation(p)), a = Math.max(0, from), b = to < 0 ? pts.length - 1 : to;
+    for (let i = a + 1; i < b; i++) bled[i] = { ...pts[i], c: mix(pts[a].c, pts[b].c, (cum[i] - cum[a]) / (cum[b] - cum[a] || 1)) };
+  }
+  return { pts: bled, stations: run.filter(isStation) };
+}
+/** `a` blended `t` of the way to `b`, both `#rrggbb`. */
+const mix = (a: string, b: string, t: number) => {
+  const [x, y] = [a, b].map((h) => parseInt(h.slice(1), 16)), u = Math.max(0, Math.min(1, t));
+  const ch = (s: number) => Math.round(((x >> s) & 255) * (1 - u) + ((y >> s) & 255) * u);
+  return `#${((ch(16) << 16) | (ch(8) << 8) | ch(0)).toString(16).padStart(6, "0")}`;
+};
