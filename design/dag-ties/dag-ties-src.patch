@@ -0,0 +1,207 @@
+// Design mockup only (design/dag-ties): the DAGs tied to a Board state, drawn back onto the Star Map as a small DAGs hangar docked beside each
+// state they act on. Which DAGs are tied, the transition each writes or is cued by, the state each belongs to, and where each hangar and its
+// orbiters sit; the renderer draws them (drawTies) and mock.js simulates their runs.
+//   write   — the DAG writes a Board transition (the machine's `writers`)
+//   cue     — a Board event cues the DAG (the machine's `cues`)
+//   launch  — the DAG launches a skill, into a drawn lifecycle machine (a moon of In Progress) or none
+//   sub     — the DAG writes a sub-machine's events (drawn on that machine's level)
+import { bez, type BEdge, type Pt, type Scene } from "./scene";
+import type { Sky } from "./sky";
+
+export type TieKind = "write" | "cue" | "launch" | "sub";
+export interface Anchor extends Pt {
+  kind: TieKind;
+  /** The Board event (or sub-machine event) the tie is about; a launch names the flow it launches. */
+  event: string;
+  edge?: BEdge;
+  /** A Board transition's tie, marked by a diamond at the edge's middle (or its state's rim, for a loop). */
+  diamond: boolean;
+  /** For a launch: the flow, when the page draws it. */
+  flow?: string | null;
+  /** The state the tie acts on: a write's source (the state the DAG moves work out of), a cue's state (where the event lands). */
+  state?: string;
+}
+export interface Orbiter extends Pt {
+  dag: string;
+  label: string;
+  anchors: Anchor[];
+  /** The transition the DAG docks by: its diamond shows at rest, and a click opens its Ledger. */
+  primary?: Anchor;
+  ledger: string | null;
+  /** Its angle round the hub. */
+  a: number;
+}
+export interface Hub extends Pt {
+  /** The state it docks beside. */
+  state: string;
+  /** The disc's radius and the orbit's, in world units. */
+  r: number;
+  orbit: number;
+  orbs: Orbiter[];
+}
+/** The launch chip: one pill under In Progress for the DAGs that only launch work. */
+export interface Chip extends Pt {
+  label: string;
+  dags: Orbiter[];
+  anchors: Anchor[];
+}
+export interface Ties {
+  hubs: Hub[];
+  chip: Chip | null;
+  /** World units a screen pixel at the Board's fit, and the page's text size as a factor. */
+  u: number;
+  ts: number;
+}
+
+const short = (d: string) => d.replace(/^[^/]+\//, "");
+/** Screen pixels: a hangar's disc, its orbit, and the least angle between two orbiters. */
+const DISC = 13, ORBIT = 28, SEP = (40 * Math.PI) / 180;
+
+/** The tied DAGs of the Board level: a hangar per state with its orbiters for the DAGs that write or are cued by a transition, and the chip for
+ *  the DAGs that only launch work. */
+export function boardTies(sc: Scene, sky: Sky, u: number, ts = 1): Ties {
+  const board = sky.board.machine, byDag = new Map<string, Orbiter>();
+  const tie = (dag: string): Orbiter | null => {
+    if (!sky.dagBy[dag]) return null;
+    let t = byDag.get(dag);
+    if (!t) byDag.set(dag, (t = { dag, label: short(dag), anchors: [], x: 0, y: 0, ledger: null, a: 0 }));
+    return t;
+  };
+  const edgeOf = (event: string) => [...sc.bEdges, ...sc.entries, ...sc.exits].find((e) => e.events.includes(event));
+  const mid = (e: BEdge): Pt | null => (e.p0 && e.c && e.p1 ? bez(e.p0, e.c, e.p1, 0.5) : null);
+  const rimOf = (id: string, toward: Pt): Pt => {
+    const g = sc.galaxies[id], L = Math.hypot(toward.x - g.x, toward.y - g.y) || 1;
+    return { x: g.x + ((toward.x - g.x) / L) * g.R, y: g.y + ((toward.y - g.y) / L) * g.R };
+  };
+  for (const [event, ws] of Object.entries(board.writers ?? {}))
+    for (const w of ws) {
+      if (!w.actor.includes("/")) continue; // agents and the operator are not DAGs
+      const t = tie(w.actor), tr = board.transitions.find((x) => x.event === event);
+      if (!t || !tr) continue;
+      const e = edgeOf(event), m = e && !e.loop ? mid(e) : null;
+      const p = m ?? (sc.galaxies[tr.source] ? rimOf(tr.source, { x: sc.galaxies[tr.source].x, y: sc.galaxies[tr.source].y - 1 }) : null);
+      if (p) t.anchors.push({ ...p, kind: "write", event, edge: e, diamond: true, state: tr.source });
+    }
+  for (const c of sky.cues) {
+    const t = tie(c.dag), e = edgeOf(c.event), m = e ? mid(e) : null;
+    if (t && m) t.anchors.push({ ...m, kind: "cue", event: c.event, edge: e, diamond: true, state: c.state || e?.target });
+  }
+  const ip = sc.galaxies.in_progress;
+  for (const l of sky.launches) {
+    const t = tie(l.dag);
+    if (!t || !ip) continue;
+    const flow = launchedFlow(sky, l.dag, l.flow), moon = flow ? sc.moons.find((m) => m.name === flow) : undefined;
+    const at = moon ? { x: moon.x, y: moon.y } : rimOf("in_progress", { x: ip.x, y: ip.y + 1 });
+    // a DAG that also writes the launched machine's own events is drawn as that machine's writer, not only its launcher
+    const sub = !!flow && Object.values(sky.flows[flow]?.machine.writers ?? {}).some((ws) => ws.some((w) => w.actor === l.dag));
+    t.anchors.push({ ...at, kind: sub ? "sub" : "launch", event: flow ?? l.skill, diamond: false, flow });
+  }
+  const all = [...byDag.values()];
+  // each DAG belongs to the state most of its ties act on (the first, on a tie), and docks by one of that state's transitions
+  const home = (t: Orbiter) => {
+    const n = new Map<string, number>();
+    for (const a of t.anchors) if (a.diamond && a.state && sc.galaxies[a.state]) n.set(a.state, (n.get(a.state) ?? 0) + 1);
+    return [...n].reduce<[string, number] | null>((b, x) => (!b || x[1] > b[1] ? x : b), null)?.[0];
+  };
+  const own = (t: Orbiter) => t.anchors.filter((a) => a.diamond && a.state === home(t));
+  // among them, the one whose edge holds the fewest DAGs so far, the DAGs with fewest ties choosing first
+  const load = new Map<BEdge | undefined, number>();
+  for (const t of all.filter((t) => own(t).length).sort((a, b) => own(a).length - own(b).length)) {
+    const a = own(t).reduce((x, y) => ((load.get(y.edge) ?? 0) < (load.get(x.edge) ?? 0) ? y : x));
+    load.set(a.edge, (load.get(a.edge) ?? 0) + 1);
+    t.primary = a;
+    t.ledger = a.event;
+  }
+  const orbs = all.filter((t) => t.primary), launchers = all.filter((t) => !t.primary);
+  const chip = launchers.length && ip
+    ? { label: `✦ ${launchers.length} DAGs launch work here`, dags: launchers, anchors: launchers.flatMap((t) => t.anchors), x: ip.x, y: ip.y + Math.max(ip.visR, ip.moonR) + 34 * u }
+    : null;
+  const byState = new Map<string, Orbiter[]>();
+  for (const t of orbs) byState.set(t.primary!.state!, [...(byState.get(t.primary!.state!) ?? []), t]);
+  const hubs: Hub[] = [];
+  for (const [state, os] of byState) hubs.push(place(sc, state, os, hubs, chip, u, ts));
+  return { hubs, chip, u, ts };
+}
+
+/** A hangar docks beside its state, in the first open spot round it (above right, above left, below right, below left, then square on): clear
+ *  of every state's disc and name, of the hangars already placed and of the launch chip, with room for its own name under it, and nearer its
+ *  own state than any other. Each orbiter
+ *  turns toward the transition it docks by, spread so no two touch. */
+function place(sc: Scene, state: string, orbs: Orbiter[], placed: Hub[], chip: Chip | null, u: number, ts: number): Hub {
+  const g = sc.galaxies[state], gs = Object.values(sc.galaxies), r = DISC * u, orbit = ORBIT * u;
+  type Box = [number, number, number, number];
+  const over = (a: Box, b: Box) => Math.max(0, Math.min(a[2], b[2]) - Math.max(a[0], b[0])) * Math.max(0, Math.min(a[3], b[3]) - Math.max(a[1], b[1]));
+  const keep: Box[] = gs.map((s) => {
+    // its disc, and its name and count, which can run wider than the disc
+    const R = Math.max(s.R, s.visR, s.moonR), w = Math.max(R, (s.name.length * 4 + 6) * u * ts);
+    return [s.x - w, Math.min(s.y - R, s.lab.y - 16 * u * ts), s.x + w, Math.max(s.y + R, s.lab.y + 26 * u * ts)];
+  });
+  // the map's own width: a hangar keeps between the outermost states, never under the side panels
+  const x0 = Math.min(...keep.map((b) => b[0])) - 30 * u, x1 = Math.max(...keep.map((b) => b[2])) + 30 * u;
+  // a moon's name runs out on the side away from its state, cut to a few words
+  for (const m of sc.moons) keep.push(m.x < m.parent.x ? [m.x - 80 * u * ts, m.y - 9 * u * ts, m.x + 8 * u, m.y + 9 * u * ts] : [m.x - 8 * u, m.y - 9 * u * ts, m.x + 80 * u * ts, m.y + 9 * u * ts]);
+  for (const h of placed) keep.push(boxOf(h.x, h.y, h.orbit, widest(h.orbs), u, ts));
+  if (chip) keep.push([chip.x - 110 * u * ts, chip.y - 14 * u, chip.x + 110 * u * ts, chip.y + 14 * u]);
+  const R = Math.max(g.R, g.visR, g.moonR), gap = orbit + 6 * u, name = widest(orbs);
+  const tries: Pt[] = [];
+  for (const d of [R + gap, R + gap + 24 * u, R + gap + 56 * u, R + gap + 96 * u])
+    for (const deg of [-40, -140, 40, 140, 0, 180, -90, 90, -65, -115, 65, 115, -20, -160, 20, 160]) tries.push({ x: g.x + Math.cos((deg * Math.PI) / 180) * d, y: g.y + Math.sin((deg * Math.PI) / 180) * d });
+  // the first clear spot nearest its own state, else the one that costs least
+  const cost = (p: Pt) => {
+    const box = boxOf(p.x, p.y, orbit, name, u, ts);
+    return keep.reduce((n, b) => n + over(box, b), 0) + (box[0] < x0 || box[2] > x1 ? 1e9 : 0);
+  };
+  // and nearer its own state's rim than any other's, so it reads as that state's
+  const rim = (s: (typeof gs)[number], p: Pt) => Math.hypot(p.x - s.x, p.y - s.y) - Math.max(s.R, s.visR, s.moonR);
+  const mine = (p: Pt) => gs.every((s) => s === g || rim(s, p) > rim(g, p) + 12 * u);
+  // a spot that reads as another state's costs more than grazing a neighbour's corner
+  const score = (p: Pt) => cost(p) + (mine(p) ? 0 : 2500 * u * u);
+  const at = tries.find((p) => score(p) === 0) ?? tries.reduce((a, b) => (score(b) < score(a) ? b : a));
+  const hub: Hub = { x: at.x, y: at.y, state, r, orbit, orbs };
+  const aim = (t: Orbiter) => Math.atan2(t.primary!.y - hub.y, t.primary!.x - hub.x);
+  const order = [...orbs].sort((a, b) => aim(a) - aim(b));
+  order.forEach((t) => (t.a = aim(t)));
+  // neighbours closer than SEP push apart, half each, until none are; the ring wraps
+  const sep = Math.min(SEP, (Math.PI * 2) / order.length);
+  for (let pass = 0; pass < 60; pass++)
+    for (let i = 0; i < order.length; i++) {
+      const p = order[i], q = order[(i + 1) % order.length];
+      let d = q.a - p.a;
+      if (i === order.length - 1) d += Math.PI * 2;
+      if (order.length < 2 || d >= sep) continue;
+      p.a -= (sep - d) / 2;
+      q.a += (sep - d) / 2;
+    }
+  for (const t of orbs) Object.assign(t, { x: hub.x + Math.cos(t.a) * orbit, y: hub.y + Math.sin(t.a) * orbit });
+  return hub;
+}
+/** A hangar's name: its one DAG, or how many it holds. */
+export const nameOf = (orbs: Orbiter[]) => (orbs.length === 1 ? orbs[0].label : `${orbs.length} DAGs`);
+/** The widest line a hangar's name can show: its name, or one member's "<dag> running". */
+const widest = (orbs: Orbiter[]) => (orbs.length === 1 ? orbs[0].label : orbs.reduce((w, o) => (o.label.length + 8 > w.length ? `${o.label} running` : w), nameOf(orbs)));
+/** The room a hangar takes: its orbit, and its name (up to two lines) under it. */
+const boxOf = (x: number, y: number, orbit: number, name: string, u: number, ts: number): [number, number, number, number] => {
+  const w = Math.max(orbit + 8 * u, (name.length * 3.4 + 4) * u * ts);
+  return [x - w, y - orbit - 8 * u, x + w, y + orbit + (10 + 32 * ts) * u];
+};
+
+/** The flow a DAG launches: the machine tie the server derived (D8), else the launch's own flow name when the page draws one. */
+function launchedFlow(sky: Sky, dag: string, flow: string | null): string | null {
+  for (const [name, f] of Object.entries(sky.flows)) if ((f as { ties?: { kind: string; dag: string | null }[] }).ties?.some((x) => x.kind === "dag" && x.dag === dag)) return name;
+  return flow && sky.flows[flow] ? flow : null;
+}
+
+/** Whether a tied DAG is moving now in the mock (mock.js sets `window.__ties`): its status and when it started and ended. */
+export interface SimRun {
+  status: "running" | "succeeded" | "failed" | "queued";
+  t0: number;
+  dur: number;
+  /** When the run ended. */
+  fin?: number;
+  /** When a finished run wrote its transition, and which event (its docked transition when unnamed). */
+  wrote?: number;
+  event?: string;
+  /** A failed run stays red until the cue's resolves rule clears it. */
+  unresolved?: boolean;
+}
+export const simOf = (dag: string): SimRun | undefined => (window as unknown as { __ties?: Record<string, SimRun> }).__ties?.[dag];
