+// Design mockup only (design/dag-ties): the DAGs tied to a Board state, drawn back onto the Star Map as a small DAGs hangar docked beside each
+// state they act on. Which DAGs are tied, the transition each writes or is cued by, the state each belongs to, and where each hangar and its
+// orbiters sit; the renderer draws them (drawTies) and mock.js simulates their runs.
+//   write   — the DAG writes a Board transition (the machine's `writers`)
+//   cue     — a Board event cues the DAG (the machine's `cues`)
+//   launch  — the DAG launches a skill, into a drawn lifecycle machine (a moon of In Progress) or none
+//   sub     — the DAG writes a sub-machine's events (drawn on that machine's level)
+import { bez, type BEdge, type Pt, type Scene } from "./scene";
+import type { Sky } from "./sky";
+
+export type TieKind = "write" | "cue" | "launch" | "sub";
+export interface Anchor extends Pt {
+  kind: TieKind;
+  /** The Board event (or sub-machine event) the tie is about; a launch names the flow it launches. */
+  event: string;
+  edge?: BEdge;
+  /** A Board transition's tie, marked by a diamond at the edge's middle (or its state's rim, for a loop). */
+  diamond: boolean;
+  /** For a launch: the flow, when the page draws it. */
+  flow?: string | null;
+  /** The state the tie acts on: a write's source (the state the DAG moves work out of), a cue's state (where the event lands). */
+  state?: string;
+}
+export interface Orbiter extends Pt {
+  dag: string;
+  label: string;
+  anchors: Anchor[];
+  /** The transition the DAG docks by: its diamond shows at rest, and a click opens its Ledger. */
+  primary?: Anchor;
+  ledger: string | null;
+  /** Its angle round the hub. */
+  a: number;
+}
+export interface Hub extends Pt {
+  /** The state it docks beside. */
+  state: string;
+  /** The disc's radius and the orbit's, in world units. */
+  r: number;
+  orbit: number;
+  orbs: Orbiter[];
+  /** How it docks (the review bar's `?place=`), and its orbiters' size as a share of a full hangar's. */
+  style: Place;
+  small: number;
+  /** The centre its orbiters circle when not its own (orbiting the state itself). */
+  c?: Pt;
+  /** The side its name sits on, away from what it docks by; orbiting its state, the name's own anchor and alignment instead. */
+  dir: Dir;
+  lab: Pt;
+  align: CanvasTextAlign;
+  hitR: number;
+  box: [number, number, number, number];
+  /** Orbiting its state: the stretches of the ring its arc draws, clear of every name it would cross. */
+  arcs?: [number, number][];
+}
+export interface Ties {
+  hubs: Hub[];
+  /** World units a screen pixel at the Board's fit, and the page's text size as a factor. */
+  u: number;
+  ts: number;
+}
