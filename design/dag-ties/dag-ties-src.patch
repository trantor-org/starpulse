+// Design mockup only (design/dag-ties): the DAGs tied to a Board state, drawn back onto the Star Map as one DAGs hub. Which DAGs are tied, the
+// transition each writes or is cued by, and where the hub and each DAG's orbiter sit; the renderer draws them (drawTies) and mock.js simulates
+// their runs.
+//   write   — the DAG writes a Board transition (the machine's `writers`)
+//   cue     — a Board event cues the DAG (the machine's `cues`)
+//   launch  — the DAG launches a skill, into a drawn lifecycle machine (a moon of In Progress) or none
+//   sub     — the DAG writes a sub-machine's events (drawn on that machine's level)
+import { bez, type BEdge, type Pt, type Scene } from "./scene";
+import type { Sky } from "./sky";
+
+export type TieKind = "write" | "cue" | "launch" | "sub";
+/** How the hub's orbiters sit: each turned toward the transition it docks by, or evenly round the ring (the old DAGs hangar). */
+export type Ring = "aim" | "even";
+/** How a write or cue shows: a comet between the DAG's orbiter and the transition, or a comet along the transition's own edge. */
+export type Motion = "hub" | "edge";
+export interface Anchor extends Pt {
+  kind: TieKind;
+  /** The Board event (or sub-machine event) the tie is about; a launch names the flow it launches. */
+  event: string;
+  edge?: BEdge;
+  /** A Board transition's tie, marked by a diamond at the edge's middle (or its state's rim, for a loop). */
+  diamond: boolean;
+  /** For a launch: the flow, when the page draws it. */
+  flow?: string | null;
+}
+export interface Orbiter extends Pt {
+  dag: string;
+  label: string;
+  anchors: Anchor[];
+  /** The transition the DAG docks by: its diamond shows at rest, and a click opens its Ledger. */
+  primary?: Anchor;
+  ledger: string | null;
+  /** Its angle round the hub. */
+  a: number;
+}
+export interface Hub extends Pt {
+  /** The disc's radius and the orbit's, in world units. */
+  r: number;
+  orbit: number;
+  orbs: Orbiter[];
+}
+/** The launch chip: one pill under In Progress for the DAGs that only launch work. */
+export interface Chip extends Pt {
+  label: string;
+  dags: Orbiter[];
+  anchors: Anchor[];
+}
+export interface Ties {
+  hub: Hub | null;
+  chip: Chip | null;
+  /** World units a screen pixel at the Board's fit, and the page's text size as a factor. */
+  u: number;
+  ts: number;
+}
+
+const short = (d: string) => d.replace(/^[^/]+\//, "");
+export const ringOf = (q: URLSearchParams): Ring => (q.get("ring") === "even" ? "even" : "aim");
+export const motionOf = (q: URLSearchParams): Motion => (q.get("motion") === "edge" ? "edge" : "hub");
+/** Screen pixels: the hub disc, its orbit, and the least angle between two orbiters. */
+const DISC = 22, ORBIT = 44, SEP = (26 * Math.PI) / 180;
+
+/** The tied DAGs of the Board level: the hub and its orbiters for the DAGs that write or are cued by a transition, and the chip for the rest. */
+export function boardTies(sc: Scene, sky: Sky, ring: Ring, u: number, ts = 1): Ties {
+  const board = sky.board.machine, byDag = new Map<string, Orbiter>();
+  const tie = (dag: string): Orbiter | null => {
+    if (!sky.dagBy[dag]) return null;
+    let t = byDag.get(dag);
+    if (!t) byDag.set(dag, (t = { dag, label: short(dag), anchors: [], x: 0, y: 0, ledger: null, a: 0 }));
+    return t;
+  };
+  const edgeOf = (event: string) => [...sc.bEdges, ...sc.entries, ...sc.exits].find((e) => e.events.includes(event));
+  const mid = (e: BEdge): Pt | null => (e.p0 && e.c && e.p1 ? bez(e.p0, e.c, e.p1, 0.5) : null);
+  const rimOf = (id: string, toward: Pt): Pt => {
+    const g = sc.galaxies[id], L = Math.hypot(toward.x - g.x, toward.y - g.y) || 1;
+    return { x: g.x + ((toward.x - g.x) / L) * g.R, y: g.y + ((toward.y - g.y) / L) * g.R };
+  };
+  for (const [event, ws] of Object.entries(board.writers ?? {}))
+    for (const w of ws) {
+      if (!w.actor.includes("/")) continue; // agents and the operator are not DAGs
+      const t = tie(w.actor), tr = board.transitions.find((x) => x.event === event);
+      if (!t || !tr) continue;
+      const e = edgeOf(event), m = e && !e.loop ? mid(e) : null;
+      const p = m ?? (sc.galaxies[tr.source] ? rimOf(tr.source, { x: sc.galaxies[tr.source].x, y: sc.galaxies[tr.source].y - 1 }) : null);
+      if (p) t.anchors.push({ ...p, kind: "write", event, edge: e, diamond: true });
+    }
+  for (const c of sky.cues) {
+    const t = tie(c.dag), e = edgeOf(c.event), m = e ? mid(e) : null;
+    if (t && m) t.anchors.push({ ...m, kind: "cue", event: c.event, edge: e, diamond: true });
+  }
+  const ip = sc.galaxies.in_progress;
+  for (const l of sky.launches) {
+    const t = tie(l.dag);
+    if (!t || !ip) continue;
+    const flow = launchedFlow(sky, l.dag, l.flow), moon = flow ? sc.moons.find((m) => m.name === flow) : undefined;
+    const at = moon ? { x: moon.x, y: moon.y } : rimOf("in_progress", { x: ip.x, y: ip.y + 1 });
+    // a DAG that also writes the launched machine's own events is drawn as that machine's writer, not only its launcher
+    const sub = !!flow && Object.values(sky.flows[flow]?.machine.writers ?? {}).some((ws) => ws.some((w) => w.actor === l.dag));
+    t.anchors.push({ ...at, kind: sub ? "sub" : "launch", event: flow ?? l.skill, diamond: false, flow });
+  }
+  const all = [...byDag.values()], own = (t: Orbiter) => t.anchors.filter((a) => a.diamond);
+  // each DAG docks by one transition: the one whose edge holds the fewest DAGs so far, the DAGs with fewest ties choosing first
+  const load = new Map<BEdge | undefined, number>();
+  for (const t of all.filter((t) => own(t).length).sort((a, b) => own(a).length - own(b).length)) {
+    const a = own(t).reduce((x, y) => ((load.get(y.edge) ?? 0) < (load.get(x.edge) ?? 0) ? y : x));
+    load.set(a.edge, (load.get(a.edge) ?? 0) + 1);
+    t.primary = a;
+    t.ledger = a.event;
+  }
+  const orbs = all.filter((t) => t.primary), launchers = all.filter((t) => !t.primary);
+  const chip = launchers.length && ip
+    ? { label: `✦ ${launchers.length} DAGs launch work here`, dags: launchers, anchors: launchers.flatMap((t) => t.anchors), x: ip.x, y: ip.y + Math.max(ip.visR, ip.moonR) + 34 * u }
+    : null;
+  return { hub: orbs.length ? place(sc, orbs, ring, u, ts) : null, chip, u, ts };
+}
+
+/** The hub holds the right end of the Board's axis, as the DAGs hangar did: in the last column of states, level with In Progress, clear of the
+ *  states above and below it. Each orbiter turns toward the transition it docks by, spread so no two touch, or sits evenly round the ring. */
+function place(sc: Scene, orbs: Orbiter[], ring: Ring, u: number, ts: number): Hub {
+  const gs = Object.values(sc.galaxies), ip = sc.galaxies.in_progress, r = DISC * u, orbit = ORBIT * u;
+  const hub: Hub = { x: Math.max(...gs.map((g) => g.x)), y: ip ? ip.y : (sc.box ? (sc.box[1] + sc.box[3]) / 2 : sc.h / 2), r, orbit, orbs };
+  // its orbit above and its name below (two lines) keep off every state's disc and the name over it
+  const up = orbit + 8 * u, down = orbit + (14 + 44 * ts) * u;
+  const top = (g: (typeof gs)[number]) => Math.min(g.y - Math.max(g.R, g.visR), g.lab.y - 16 * u * ts);
+  const bottom = (g: (typeof gs)[number]) => Math.max(g.y + Math.max(g.R, g.visR), g.lab.y + 26 * u * ts);
+  for (let i = 0; i < 40; i++) {
+    const hit = gs.find((g) => Math.abs(g.x - hub.x) < Math.max(g.R, g.visR) + orbit && (g.y < hub.y ? hub.y - up - bottom(g) : top(g) - (hub.y + down)) < 0);
+    if (!hit) break;
+    hub.y += (hit.y < hub.y ? 6 : -6) * u;
+  }
+  const aim = (t: Orbiter) => Math.atan2(t.primary!.y - hub.y, t.primary!.x - hub.x);
+  const order = [...orbs].sort((a, b) => aim(a) - aim(b));
+  if (ring === "even") order.forEach((t, i) => (t.a = (i / order.length) * Math.PI * 2 + aim(order[0])));
+  else {
+    order.forEach((t) => (t.a = aim(t)));
+    // neighbours closer than SEP push apart, half each, until none are; the ring wraps
+    const sep = Math.min(SEP, (Math.PI * 2) / order.length);
+    for (let pass = 0; pass < 60; pass++)
+      for (let i = 0; i < order.length; i++) {
+        const p = order[i], q = order[(i + 1) % order.length];
+        let d = q.a - p.a;
+        if (i === order.length - 1) d += Math.PI * 2;
+        if (order.length < 2 || d >= sep) continue;
+        p.a -= (sep - d) / 2;
+        q.a += (sep - d) / 2;
+      }
+  }
+  for (const t of orbs) Object.assign(t, { x: hub.x + Math.cos(t.a) * orbit, y: hub.y + Math.sin(t.a) * orbit });
+  return hub;
+}
+
+/** The flow a DAG launches: the machine tie the server derived (D8), else the launch's own flow name when the page draws one. */
+function launchedFlow(sky: Sky, dag: string, flow: string | null): string | null {
+  for (const [name, f] of Object.entries(sky.flows)) if ((f as { ties?: { kind: string; dag: string | null }[] }).ties?.some((x) => x.kind === "dag" && x.dag === dag)) return name;
+  return flow && sky.flows[flow] ? flow : null;
+}
+
+/** Whether a tied DAG is moving now in the mock (mock.js sets `window.__ties`): its status and when it started and ended. */
+export interface SimRun {
+  status: "running" | "succeeded" | "failed" | "queued";
+  t0: number;
+  dur: number;
+  /** When the run ended. */
+  fin?: number;
+  /** When a finished run wrote its transition, and which event (its docked transition when unnamed). */
+  wrote?: number;
+  event?: string;
+  /** A failed run stays red until the cue's resolves rule clears it. */
+  unresolved?: boolean;
+}
+export const simOf = (dag: string): SimRun | undefined => (window as unknown as { __ties?: Record<string, SimRun> }).__ties?.[dag];
