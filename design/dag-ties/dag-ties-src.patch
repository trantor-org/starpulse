+ *   side  — beside the state, in the first open spot round it
+ *   rim   — a small hangar on the state's own ring, facing its busiest line
+ *   orbit — no hangar: the DAGs orbit the state itself, just outside its ring, each toward its transition
+ *   label — a small hangar and its count in the state's own name block */
+export type Place = "edge" | "line" | "side" | "rim" | "orbit" | "label";
+export const PLACES: Place[] = ["edge", "line", "side", "rim", "orbit", "label"];
+
+export type Dir = "down" | "up" | "left" | "right";
+/** The side facing away along (dx, dy). */
+const outward = (dx: number, dy: number): Dir => (Math.abs(dy) >= Math.abs(dx) * 0.8 ? (dy > 0 ? "down" : "up") : dx > 0 ? "right" : "left");
