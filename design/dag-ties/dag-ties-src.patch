+// Design mockup only (design/dag-ties): the DAGs tied to a state, drawn back onto the Star Map. Which DAGs are tied and where
+// each sits, per placement variant; the renderer draws them (drawTies) and mock.js simulates their runs.
+//   write   — the DAG writes a Board transition (the machine's `writers`)
+//   cue     — a Board event cues the DAG (the machine's `cues`)
+//   launch  — the DAG launches a skill, into a drawn lifecycle machine (a moon of In Progress) or none
+//   sub     — the DAG writes a sub-machine's events (drawn on that machine's level)
+import { bez, glyph, type BEdge, type GNode, type Glyph, type Pt, type Scene } from "./scene";
+import type { Sky } from "./sky";
+
+export type TieKind = "write" | "cue" | "launch" | "sub";
+export type Place = "dock" | "shelf";
+/** Where the DAGs that only launch a skill go on the Board level: one chip on In Progress, or a row of their own glyphs under it. */
+export type Launch = "chip" | "row";
+export interface Anchor extends Pt {
+  kind: TieKind;
+  /** The Board event (or sub-machine event) the tie is about; a launch names the flow it launches. */
+  event: string;
+  edge?: BEdge;
+  /** The point on the edge the thread meets: the edge's midpoint, a loop's state rim, or a moon. */
+  diamond: boolean;
+  /** For a launch: the flow, when the page draws it. */
+  flow?: string | null;
+}
+export interface TieGlyph extends Pt {
+  dag: string;
+  label: string;
+  kinds: TieKind[];
+  anchors: Anchor[];
+  glyph: Glyph;
+  /** Glyph scale, so a long DAG keeps a small footprint. */
+  sc: number;
+  br: number;
+  /** The event whose Ledger a click opens. */
+  ledger: string | null;
+  /** The page's text size, as a factor: a name's footprint grows with it. */
+  ts: number;
+  /** World units a screen pixel at the Board's fit. */
+  u: number;
+  /** The transition the DAG docks by, marked by that edge's diamond at rest; its other ties show on hover. */
+  primary?: Anchor;
+  /** The launch chip: the DAGs it stands for. */
+  chip?: TieGlyph[];
+}
+
+const short = (d: string) => d.replace(/^[^/]+\//, "");
+export const placeOf = (q: URLSearchParams): Place => (q.get("place") === "shelf" ? "shelf" : "dock");
+export const launchOf = (q: URLSearchParams): Launch => (q.get("launch") === "row" ? "row" : "chip");
+
+/** The tied DAGs of the Board level, placed for `place`; `u` is world units a screen pixel at the Board's fit, so a glyph keeps a screen size. */
+export function boardTies(sc: Scene, sky: Sky, place: Place, launch: Launch, u: number, ts = 1): TieGlyph[] {
+  const board = sky.board.machine, byDag = new Map<string, TieGlyph>();
+  const tie = (dag: string): TieGlyph | null => {
+    const d = sky.dagBy[dag];
+    if (!d) return null;
+    let t = byDag.get(dag);
+    if (!t) {
+      // a glyph's step spacing reads as screen pixels, GROW times the DAGs view's, capped at SPAN across
+      const g = compact(glyph(d)), span = Math.max(g.w, g.h) * GROW, s = span > SPAN ? (SPAN / span) * GROW : GROW;
+      t = { dag, label: short(dag), kinds: [], anchors: [], glyph: g, sc: s * u, br: (Math.hypot(g.w * s, g.h * s) / 2 + 9) * u, x: 0, y: 0, ledger: null, ts, u };
+      byDag.set(dag, t);
+    }
+    return t;
+  };
+  const edgeOf = (event: string) => [...sc.bEdges, ...sc.entries, ...sc.exits].find((e) => e.events.includes(event));
+  const mid = (e: BEdge): Pt | null => (e.p0 && e.c && e.p1 ? bez(e.p0, e.c, e.p1, 0.5) : null);
+  const rimOf = (id: string, toward: Pt): Pt => {
+    const g = sc.galaxies[id], L = Math.hypot(toward.x - g.x, toward.y - g.y) || 1;
+    return { x: g.x + ((toward.x - g.x) / L) * g.R, y: g.y + ((toward.y - g.y) / L) * g.R };
+  };
+  const centre = boxCentre(sc);
+  for (const [event, ws] of Object.entries(board.writers ?? {}))
+    for (const w of ws) {
+      if (!w.actor.includes("/")) continue; // agents and the operator are not DAGs
+      const t = tie(w.actor), tr = board.transitions.find((x) => x.event === event);
+      if (!t || !tr) continue;
+      const e = edgeOf(event), m = e && !e.loop ? mid(e) : null;
+      const p = m ?? (sc.galaxies[tr.source] ? rimOf(tr.source, { x: sc.galaxies[tr.source].x, y: sc.galaxies[tr.source].y - 1 }) : null);
+      if (!p) continue;
+      t.anchors.push({ ...p, kind: "write", event, edge: e, diamond: true });
+      if (!t.kinds.includes("write")) t.kinds.push("write");
+      t.ledger ??= event;
+    }
+  for (const c of sky.cues) {
+    const t = tie(c.dag), e = edgeOf(c.event), m = e ? mid(e) : null;
+    if (!t || !m) continue;
+    t.anchors.push({ ...m, kind: "cue", event: c.event, edge: e, diamond: true });
+    t.kinds.push("cue");
+    t.ledger ??= c.event;
+  }
+  const ip = sc.galaxies.in_progress;
+  for (const l of sky.launches) {
+    const t = tie(l.dag);
+    if (!t || !ip) continue;
+    const flow = launchedFlow(sky, l.dag, l.flow), moon = flow ? sc.moons.find((m) => m.name === flow) : undefined;
+    const at = moon ? { x: moon.x, y: moon.y } : rimOf("in_progress", { x: ip.x, y: ip.y + 1 });
+    // a DAG that also writes the launched machine's own events is drawn as that machine's writer, not only its launcher
+    const sub = !!flow && Object.values(sky.flows[flow]?.machine.writers ?? {}).some((ws) => ws.some((w) => w.actor === l.dag));
+    t.anchors.push({ ...at, kind: sub ? "sub" : "launch", event: flow ?? l.skill, diamond: false, flow });
+    t.kinds.push(sub ? "sub" : "launch");
+  }
+  const all = [...byDag.values()], own = (t: TieGlyph) => t.anchors.filter((a) => a.diamond);
+  // each DAG docks by one transition: the one whose edge holds the fewest DAGs so far, the DAGs with fewest ties choosing first, and a click opens its Ledger
+  const load = new Map<BEdge | undefined, number>();
+  for (const t of [...all].filter((t) => own(t).length).sort((a, b) => own(a).length - own(b).length)) {
+    const a = own(t).reduce((x, y) => ((load.get(y.edge) ?? 0) < (load.get(x.edge) ?? 0) ? y : x));
+    load.set(a.edge, (load.get(a.edge) ?? 0) + 1);
+    t.primary = a;
+    t.ledger = a.event;
+  }
+  const launchers = all.filter((t) => !own(t).length), ties = all.filter((t) => own(t).length);
+  if (launch === "row") ties.push(...launchers);
+  else if (launchers.length && ip) {
+    const label = `✦ ${launchers.length} DAGs launch work here`;
+    ties.push({ dag: "", label, kinds: ["launch"], anchors: launchers.flatMap((t) => t.anchors), glyph: { nodes: [], links: [], w: 0, h: 0, br: 0 }, sc: u, br: 11 * u, x: ip.x, y: ip.y + Math.max(ip.visR, ip.moonR) + 34 * u, ledger: null, ts, u, chip: launchers });
+  }
+  if (place === "shelf") rim(sc, ties.filter((t) => !t.chip), u);
+  else {
+    for (const t of ties) if (t.primary) dock(sc, t, centre, u);
+    if (launch === "row") rows(sc, launchers, u);
+  }
+  if (place === "dock" || ties.some((t) => t.chip)) relax(sc, place === "dock" ? ties : ties.filter((t) => t.chip), u, centre);
+  return ties;
+}
+const SPAN = 140, GROW = 1.35, STACK = 3;
+
+/** A step of a tied DAG's glyph; a column of more than STACK parallel steps draws as one step counting them. */
+export type TNode = GNode & { more?: number };
+function compact(g: Glyph): Glyph {
+  const cols = new Map<number, GNode[]>();
+  for (const n of g.nodes) cols.set(n.x, [...(cols.get(n.x) ?? []), n]);
+  const to = new Map<GNode, GNode>(), nodes: TNode[] = [];
+  for (const [x, list] of cols) {
+    if (list.length <= STACK) {
+      list.forEach((n) => to.set(n, n));
+      nodes.push(...list);
+      continue;
+    }
+    const one: TNode = { ...list[0], x, y: 0, more: list.length };
+    list.forEach((n) => to.set(n, one));
+    nodes.push(one);
+  }
+  const seen = new Set<string>(), links: [GNode, GNode][] = [];
+  for (const [a, b] of g.links) {
+    const p = to.get(a)!, q = to.get(b)!, k = `${nodes.indexOf(p)}-${nodes.indexOf(q)}`;
+    if (p === q || seen.has(k)) continue;
+    seen.add(k);
+    links.push([p, q]);
+  }
+  const h = Math.max(0, ...nodes.map((n) => Math.abs(n.y))) * 2;
+  return { nodes, links, w: g.w, h, br: Math.hypot(g.w, h) / 2 + 8 };
+}
+
+/** The DAGs that only launch a skill, as glyphs: two staggered rows under In Progress, ordered by the machine each launches. */
+function rows(sc: Scene, ts: TieGlyph[], u: number) {
+  const ip = sc.galaxies.in_progress;
+  if (!ip || !ts.length) return;
+  const side = (t: TieGlyph) => (t.anchors[0].flow ? t.anchors[0].x : ip.x);
+  const y = ip.y + Math.max(ip.visR, ip.moonR) + 64 * u, order = [...ts].sort((a, b) => side(a) - side(b));
+  for (const r of [0, 1]) {
+    const row = order.filter((_, i) => i % 2 === r), w = row.map((t) => box(t, u)[2] - box(t, u)[0] + 14 * u), total = w.reduce((a, b) => a + b, 0);
+    let x = ip.x - total / 2 + (r ? 30 * u : -30 * u);
+    row.forEach((t, i) => {
+      Object.assign(t, { x: x + w[i] / 2, y: y + r * (box(t, u)[3] - box(t, u)[1] + 10 * u) });
+      x += w[i];
+    });
+  }
+}
+
+/** The flow a DAG launches: the machine tie the server derived (D8), else the launch's own flow name when the page draws one. */
+function launchedFlow(sky: Sky, dag: string, flow: string | null): string | null {
+  for (const [name, f] of Object.entries(sky.flows)) if ((f as { ties?: { kind: string; dag: string | null }[] }).ties?.some((x) => x.kind === "dag" && x.dag === dag)) return name;
+  return flow && sky.flows[flow] ? flow : null;
+}
+
+const boxCentre = (sc: Scene): Pt => {
+  const [x0, y0, x1, y1] = sc.box ?? [0, 0, sc.w, sc.h];
+  return { x: (x0 + x1) / 2, y: (y0 + y1) / 2 };
+};
+
+/** Where a docked DAG wants to sit before the relax pass: just off its transition's edge, on the side with more room from the states. */
+function dock(sc: Scene, t: TieGlyph, centre: Pt, u: number) {
+  const a = t.primary!, e = a.edge, d = t.br + 12 * u;
+  const room = (x: number, y: number) => Math.min(...Object.values(sc.galaxies).map((g) => Math.hypot(x - g.x, y - g.y) - Math.max(g.R, g.visR)));
+  if (e?.p0 && e.c && e.p1 && !e.loop) {
+    const p = bez(e.p0, e.c, e.p1, 0.48), q = bez(e.p0, e.c, e.p1, 0.52), L = Math.hypot(q.x - p.x, q.y - p.y) || 1;
+    let nx = -(q.y - p.y) / L, ny = (q.x - p.x) / L;
+    // the side whose spot clears the states by more, the side away from the map's middle on a near tie
+    const r1 = room(a.x + nx * d, a.y + ny * d), r2 = room(a.x - nx * d, a.y - ny * d);
+    if (Math.abs(r1 - r2) < 8 * u ? nx * (a.x - centre.x) + ny * (a.y - centre.y) < 0 : r2 > r1) [nx, ny] = [-nx, -ny];
+    Object.assign(t, { x: a.x + nx * d, y: a.y + ny * d });
+    return;
+  }
+  const L = Math.hypot(a.x - centre.x, a.y - centre.y) || 1;
+  Object.assign(t, { x: a.x + ((a.x - centre.x) / L) * d, y: a.y + ((a.y - centre.y) / L) * d });
+}
+
+/** A tied DAG's footprint: its glyph and the name under it. */
+export function box(t: TieGlyph, u: number): [number, number, number, number] {
+  const lw = (t.label.length * 6.7 * t.ts + 10) * u, gh = (t.glyph.h * t.sc) / 2;
+  return [t.x - Math.max(t.br, lw / 2), t.y - t.br, t.x + Math.max(t.br, lw / 2), t.y + Math.max(t.br, gh + (10 + 15 * t.ts) * u)];
+}
+
+/** Push each tied DAG, glyph and name, off the bodies and names it would cover and off the others; a few passes are enough at Board scale. */
+function relax(sc: Scene, ties: TieGlyph[], u: number, centre: Pt) {
+  const ts = ties[0]?.ts ?? 1;
+  const obstacles: (Pt & { r: number })[] = [
+    ...Object.values(sc.galaxies).map((g) => ({ x: g.x, y: g.y, r: Math.max(g.R, g.visR) + 14 * u })),
+    ...sc.moons.map((m) => ({ x: m.x, y: m.y, r: (m.R ?? 8) + 10 * u })),
+  ];
+  // a state's name and the count under it
+  const names = Object.values(sc.galaxies).map((g): [number, number, number, number] => {
+    const hw = (g.name.length * 4.2 + 10) * u * ts;
+    return [g.lab.x - hw, g.lab.y - 16 * u * ts, g.lab.x + hw, g.lab.y + 26 * u * ts];
+  });
+  const home = new Map(ties.map((t) => [t, { x: t.x, y: t.y }]));
+  for (let pass = 0; pass < 80; pass++) {
+    for (const t of ties) {
+      // a spring back to where it docked, easing off over the passes, so a crowded edge's DAGs stay by it and still end apart
+      const h = home.get(t)!, k = Math.max(0, 0.06 * (1 - pass / 50));
+      t.x += (h.x - t.x) * k;
+      t.y += (h.y - t.y) * k;
+      for (const o of obstacles) {
+        const [x0, y0, x1, y1] = box(t, u), nx = Math.max(x0, Math.min(o.x, x1)), ny = Math.max(y0, Math.min(o.y, y1));
+        let dx = nx - o.x, dy = ny - o.y, d = Math.hypot(dx, dy);
+        if (d >= o.r) continue;
+        if (d < 0.01) [dx, dy, d] = [t.x - o.x || 0.01, t.y - o.y, Math.hypot(t.x - o.x || 0.01, t.y - o.y)];
+        const k = d < 0.01 ? o.r : o.r - d;
+        t.x += (dx / d) * k;
+        t.y += (dy / d) * k;
+      }
+      for (const b of names) {
+        const a = box(t, u), ox = Math.min(a[2], b[2]) - Math.max(a[0], b[0]), oy = Math.min(a[3], b[3]) - Math.max(a[1], b[1]);
+        if (ox <= 0 || oy <= 0) continue;
+        if (ox < oy) t.x += ox * Math.sign(t.x - (b[0] + b[2]) / 2 || 1);
+        else t.y += oy * Math.sign(t.y - (b[1] + b[3]) / 2 || 1);
+      }
+      for (const v of ties) {
+        if (v === t) continue;
+        const a = box(t, u), b = box(v, u), ox = Math.min(a[2], b[2]) - Math.max(a[0], b[0]) + 6 * u, oy = Math.min(a[3], b[3]) - Math.max(a[1], b[1]) + 6 * u;
+        if (ox <= 0 || oy <= 0) continue;
+        // apart along the shorter overlap
+        if (ox < oy) {
+          const k = (ox / 2) * Math.sign(t.x - v.x || 1);
+          t.x += k;
+          v.x -= k;
+        } else {
+          const k = (oy / 2) * Math.sign(t.y - v.y || 1);
+          t.y += k;
+          v.y -= k;
+        }
+      }
+    }
+  }
+  // one wedged between two bodies too close to hold it walks out from the map's middle until it is clear
+  const hits = (t: TieGlyph) => {
+    const a = box(t, u);
+    return obstacles.some((o) => Math.hypot(Math.max(a[0], Math.min(o.x, a[2])) - o.x, Math.max(a[1], Math.min(o.y, a[3])) - o.y) < o.r - 2 * u)
