+    const a = own(t).reduce((x, y) => ((load.get(y.edge) ?? 0) < (load.get(x.edge) ?? 0) ? y : x));
+    load.set(a.edge, (load.get(a.edge) ?? 0) + 1);
+    t.primary = a;
+    t.ledger = a.event;
+  }
+  const orbs = all.filter((t) => t.primary);
+  const byState = new Map<string, Orbiter[]>();
+  for (const t of orbs) byState.set(t.primary!.state!, [...(byState.get(t.primary!.state!) ?? []), t]);
+  const hubs: Hub[] = [];
+  for (const [state, os] of byState) hubs.push(place(sc, state, os, hubs, u, ts, mode));
+  return { hubs, u, ts };
+}
