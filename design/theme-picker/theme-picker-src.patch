+++ b/starpulse/web/src/features/admin/theme/recolor.ts
@@ -0,0 +1,152 @@
+// Mockup only: redraws the page in a theme's tokens without touching its drawing code. Every color the page paints (stylesheet
+// rules, inline styles, SVG paint and canvas strokes) is mapped from today's palette onto the theme's: a color that is one of
+// today's tokens becomes that token's new value, and any other color keeps its lightness and chroma offset from the nearest token.
+// The shipped picker swaps the tokens themselves; this stands in for it until the drawing code reads them.
+import { labOfRgb, lchOfRgb, rgb255, rgbOf, type Lch, type Rgb } from "./color";
+import type { Tokens } from "./themeStore";
+
+const COLOR = /#([0-9a-fA-F]{8}|[0-9a-fA-F]{6}|[0-9a-fA-F]{3,4})\b|rgba?\(\s*([\d.]+)[\s,]+([\d.]+)[\s,]+([\d.]+)\s*(?:[,/]\s*([\d.]+%?))?\s*\)/g;
+const ALIAS: Record<string, string> = { mapped: "ready" };
+const ATTRS = ["style", "fill", "stroke", "stop-color"];
+const CHROMATIC = 0.035, SAME = 0.004, MAX_RATIO = 1.6;
+
+interface Anchor { lab: Rgb; lch: Lch; chromatic: boolean; to: Lch; out: Rgb }
+
+const expand = (h: string) => (h.length <= 4 ? [...h].map((c) => c + c).join("") : h);
+
+/** today's `:root` hex tokens, read from the stylesheet before anything is rewritten */
+function todaysTokens(): Map<string, string> {
+  const out = new Map<string, string>();
+  for (const sheet of document.styleSheets) for (const rule of rulesOf(sheet)) {
+    if (!(rule instanceof CSSStyleRule) || rule.selectorText !== ":root") continue;
+    for (const p of rule.style) {
+      const v = rule.style.getPropertyValue(p).trim();
+      if (p.startsWith("--") && /^#[0-9a-fA-F]{3,8}$/.test(v)) out.set(p.slice(2), `#${expand(v.slice(1)).slice(0, 6).toLowerCase()}`);
+    }
+  }
+  return out;
+}
+
+function rulesOf(sheet: CSSStyleSheet | CSSGroupingRule): CSSRule[] {
+  let rules: CSSRuleList;
+  try {
+    rules = sheet.cssRules;
+  } catch {
+    return [];
+  }
+  return [...rules].flatMap((r) => ("cssRules" in r ? [r, ...rulesOf(r as CSSGroupingRule)] : [r]));
+}
+
+export function installRecolor(): (t: Tokens) => void {
+  const today = todaysTokens();
+  let anchors: Anchor[] = [];
+  const memo = new Map<string, string>();
+
+  const mapRgb = (rgb: Rgb): Rgb => {
+    const lab = labOfRgb(rgb), lch = lchOfRgb(rgb), chromatic = lch[1] > CHROMATIC;
+    let best: Anchor | null = null, bd = Infinity;
+    for (const a of anchors) {
+      if (a.chromatic !== chromatic) continue;
+      const d = Math.hypot(a.lab[0] - lab[0], a.lab[1] - lab[1], a.lab[2] - lab[2]);
+      if (d < bd) [best, bd] = [a, d];
+    }
+    if (!best) return rgb.map((v) => Math.round(v * 255)) as Rgb;
+    if (bd < SAME) return best.out;
+    const ratio = Math.min(MAX_RATIO, lch[1] / Math.max(best.lch[1], 1e-3));
+    const c = chromatic ? best.to[1] * ratio : Math.max(0, best.to[1] + lch[1] - best.lch[1]);
+    return rgb255([best.to[0] + lch[0] - best.lch[0], c, chromatic ? best.to[2] + lch[2] - best.lch[2] : best.to[2]]);
+  };
+
+  const mapText = (s: string) => {
+    const hit = memo.get(s);
+    if (hit !== undefined) return hit;
+    const out = s.replace(COLOR, (_m, h: string | undefined, r?: string, g?: string, b?: string, a?: string) => {
+      let rgb: Rgb, alpha: string | undefined;
+      if (h) {
+        const x = expand(h);
+        rgb = rgbOf(`#${x.slice(0, 6)}`);
+        if (x.length === 8) alpha = (parseInt(x.slice(6), 16) / 255).toFixed(3);
+      } else {
+        rgb = [r, g, b].map((v) => Number(v) / 255) as Rgb;
+        alpha = a;
+      }
+      const [R, G, B] = mapRgb(rgb);
+      return alpha === undefined ? `rgb(${R}, ${G}, ${B})` : `rgba(${R}, ${G}, ${B}, ${alpha})`;
+    });
+    memo.set(s, out);
+    return out;
+  };
+
+  // stylesheet rules: each rewrite starts from the value the stylesheet shipped
+  const rules: [CSSStyleDeclaration, string, string, string][] = [];
+  for (const sheet of document.styleSheets) for (const rule of rulesOf(sheet)) {
+    if (!(rule instanceof CSSStyleRule)) continue;
+    for (const p of rule.style) {
+      const v = rule.style.getPropertyValue(p);
+      if (COLOR.test(v)) rules.push([rule.style, p, v, rule.style.getPropertyPriority(p)]);
+      COLOR.lastIndex = 0;
+    }
+  }
+
+  // canvas paint goes through the mapping as it is set
+  const ctx = CanvasRenderingContext2D.prototype;
+  for (const prop of ["fillStyle", "strokeStyle", "shadowColor"] as const) {
+    const d = Object.getOwnPropertyDescriptor(ctx, prop)!;
+    Object.defineProperty(ctx, prop, { ...d, set(v: unknown) { d.set!.call(this, typeof v === "string" ? mapText(v) : v); } });
+  }
+  const stop = CanvasGradient.prototype.addColorStop;
+  CanvasGradient.prototype.addColorStop = function (o: number, c: string) { stop.call(this, o, mapText(c)); };
+
+  // inline styles and SVG paint: the page's own value is kept so a theme change maps it again, and our own writes are skipped
+  const seen = new WeakMap<Element, Map<string, { orig: string; out: string }>>();
+  const touch = (el: Element) => {
+    if (el.closest("[data-theme-raw]")) return;
+    for (const attr of ATTRS) {
+      const v = el.getAttribute(attr);
+      if (v === null) continue;
+      let m = seen.get(el);
+      const was = m?.get(attr);
+      if (was?.out === v) continue;
+      COLOR.lastIndex = 0;
+      if (!COLOR.test(v)) continue;
+      COLOR.lastIndex = 0;
+      const out = mapText(v);
+      if (!m) seen.set(el, (m = new Map()));
+      m.set(attr, { orig: v, out });
+      if (out !== v) el.setAttribute(attr, out);
+    }
+  };
+  const sweep = (root: Element) => {
+    touch(root);
+    for (const el of root.querySelectorAll(ATTRS.map((a) => `[${a}]`).join(","))) touch(el);
+  };
+  new MutationObserver((records) => {
+    for (const r of records) {
+      if (r.type === "attributes") touch(r.target as Element);
+      else for (const n of r.addedNodes) if (n instanceof Element) sweep(n);
+    }
+  }).observe(document.documentElement, { subtree: true, childList: true, attributes: true, attributeFilter: ATTRS });
+
+  return (t: Tokens) => {
+    anchors = [...today].flatMap(([name, from]) => {
+      const to = t[ALIAS[name] ?? name];
+      if (!to) return [];
+      const rgb = rgbOf(from), lch = lchOfRgb(rgb), toRgb = rgbOf(to);
+      return [{ lab: labOfRgb(rgb), lch, chromatic: lch[1] > CHROMATIC, to: lchOfRgb(toRgb), out: toRgb.map((v) => Math.round(v * 255)) as Rgb }];
+    });
+    memo.clear();
+    for (const [style, p, v, pri] of rules) style.setProperty(p, mapText(v), pri);
+    const all = document.querySelectorAll(ATTRS.map((a) => `[${a}]`).join(","));
+    for (const el of all) {
+      if (el.closest("[data-theme-raw]")) continue;
+      for (const [attr, { orig }] of seen.get(el) ?? []) {
+        const out = mapText(orig);
+        seen.get(el)!.set(attr, { orig, out });
+        el.setAttribute(attr, out);
+      }
+      touch(el);
+    }
+    window.dispatchEvent(new Event("resize"));
+    window.dispatchEvent(new Event("sp:theme"));
+  };
+}
