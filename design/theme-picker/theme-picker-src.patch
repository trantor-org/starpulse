+// Swatches carry data-theme-raw: they show a pack's own colors, never the page's.
+import { useMemo, useState, useSyncExternalStore, type ReactNode } from "react";
+import { BUILTIN, DISTINCT, NEUTRALS, REFUSE_DE, SLATE, WARN_DE, bgRefusal, build, closest, fromBase16, rampFrom, type Neutrals, type Nudge, type Pack } from "./scheme";
+import type { ThemeStore } from "./themeStore";
+
+const ROLE_LABEL: Record<string, string> = {
+  ok: "passing", run: "running", fail: "failing", agent: "agent", hold: "held", waits: "waits on", ready: "ready", released: "released", phase: "phase",
+};
+const de = (d: number) => d.toFixed(3).replace(/^0/, "");
+
+function Swatches({ t }: { t: Record<string, string> }) {
+  return <span className="sws" data-theme-raw="">{DISTINCT.map((k) => <i key={k} title={ROLE_LABEL[k]} style={{ background: t[k] }} />)}</span>;
+}
+
+function Ramp({ n }: { n: Neutrals }) {
+  return <span className="ramp" data-theme-raw="">{NEUTRALS.map((k) => <i key={k} title={k} style={{ background: n[k] }} />)}</span>;
+}
+
+/** A tile's name, its Rename field, or its Delete confirmation, for the packs and backgrounds this browser imported. */
+function Own({ name, rename, remove, children }: { name: string; rename: (v: string) => void; remove: () => void; children: (title: ReactNode) => ReactNode }) {
+  const [mode, setMode] = useState<"rename" | "delete" | null>(null);
+  const [draft, setDraft] = useState(name);
+  const save = () => {
+    if (draft.trim()) rename(draft.trim());
+    setMode(null);
+  };
+  const title = mode === "rename"
+    ? <input className="ren" autoFocus value={draft} aria-label={`Rename ${name}`} maxLength={40} onChange={(e) => setDraft(e.target.value)}
+        onBlur={save} onKeyDown={(e) => {
+          if (e.key === "Enter") save();
+          if (e.key === "Escape") { setDraft(name); setMode(null); }
+        }} />
+    : null;
+  return (
+    <div className="own">
+      {children(title)}
+      {mode === "delete"
+        ? <div className="acts conf" role="group" aria-label={`Delete ${name}?`}>Delete {name}? <button className="link del" autoFocus onClick={remove}>Delete</button><button className="link" onClick={() => setMode(null)}>Keep</button></div>
+        : mode === null && <div className="acts"><button className="link" onClick={() => { setDraft(name); setMode("rename"); }}>Rename</button><button className="link" onClick={() => setMode("delete")}>Delete</button></div>}
+    </div>
+  );
+}
+
+function PackTile({ pack, on, n, choose, title }: { pack: Pack; on: boolean; n: Neutrals; choose: () => void; title?: ReactNode }) {
+  const t = useMemo(() => build(pack, n).t, [pack, n]);
+  return (
+    <div className={`tile${on ? " on" : ""}`}>
+      {title && <div className="nm">{title}</div>}
+      <button className="pick" aria-pressed={on} onClick={choose}>
+        {!title && <span className="nm">{pack.name}</span>}
+        <Swatches t={t} />
+        <span className="src">{pack.src?.label ?? ""}</span>
+      </button>
+    </div>
+  );
+}
+
+function BgTile({ name, n, on, choose, title }: { name: string; n: Neutrals; on: boolean; choose: () => void; title?: ReactNode }) {
+  return (
+    <div className={`tile${on ? " on" : ""}`}>
+      {title && <div className="nm">{title}</div>}
+      <button className="pick" aria-pressed={on} onClick={choose}>
+        {!title && <span className="nm">{name}</span>}
+        <Ramp n={n} />
+      </button>
+    </div>
+  );
+}
+
+export function ThemeCard({ theme }: { theme: ThemeStore }) {
+  const prefs = useSyncExternalStore(theme.subscribe, theme.get);
+  const [dialog, setDialog] = useState<"pack" | "bg" | null>(null);
+  const n = theme.bgOf(prefs.bg);
+  return (
+    <section className="card thm">
+      <h2>Theme <span className="c">kept on this device only</span></h2>
+      <div className="row wide">
+        <div><div className="lb">Color pack</div><div className="hint">The status colors: passing, running, failing and the rest. Each swatch row is drawn on your background.</div></div>
+        <div className="tiles packs">
+          {Object.entries(BUILTIN).map(([id, p]) => <PackTile key={id} pack={p} n={n} on={prefs.pack === id} choose={() => theme.choosePack(id)} />)}
+          {prefs.packs.map(({ id, pack }) => (
+            <Own key={id} name={pack.name} rename={(v) => theme.renamePack(id, v)} remove={() => theme.deletePack(id)}>
+              {(title) => <PackTile pack={pack} n={n} on={prefs.pack === id} choose={() => theme.choosePack(id)} title={title} />}
+            </Own>
+          ))}
+          <button className="tile add" onClick={() => setDialog("pack")}><span className="plus">+</span>Import scheme<span className="src">base16 or base24 YAML</span></button>
+        </div>
+      </div>
+      <div className="row wide">
+        <div><div className="lb">Background</div><div className="hint">The page, panels and text, darkest to lightest. Any pack goes on any background.</div></div>
+        <div className="tiles bgs">
+          <BgTile name="Slate" n={SLATE} on={prefs.bg === "slate"} choose={() => theme.chooseBg("slate")} />
+          {prefs.bgs.map((b) => (
+            <Own key={b.id} name={b.name} rename={(v) => theme.renameBg(b.id, v)} remove={() => theme.deleteBg(b.id)}>
+              {(title) => <BgTile name={b.name} n={b.n} on={prefs.bg === b.id} choose={() => theme.chooseBg(b.id)} title={title} />}
+            </Own>
+          ))}
+          <button className="tile add" onClick={() => setDialog("bg")}><span className="plus">+</span>Add background<span className="src">from one color or a scheme</span></button>
+        </div>
+      </div>
+      {dialog === "pack" && <ImportDialog theme={theme} close={() => setDialog(null)} />}
+      {dialog === "bg" && <BgDialog theme={theme} close={() => setDialog(null)} />}
+    </section>
+  );
+}
+
+function Modal({ label, close, children }: { label: string; close: () => void; children: ReactNode }) {
+  return (
+    <div id="kbm" className="thm" onClick={(e) => e.target === e.currentTarget && close()}>
+      <div className="modal ask" role="dialog" aria-label={label} onKeyDown={(e) => e.key === "Escape" && close()}>
+        <button className="x" onClick={close} aria-label="Close">✕</button>
+        <h2>{label}</h2>
+        {children}
+      </div>
+    </div>
+  );
+}
+
+/** The scheme's text from a file or the paste box: one source, so a picked file shows in the box it can be edited in. */
+function SchemeSource({ text, setText }: { text: string; setText: (v: string) => void }) {
+  return (
+    <>
+      <div className="row">
+        <span className="lb">File</span>
+        <input type="file" accept=".yaml,.yml,.txt" aria-label="Scheme file" onChange={(e) => void e.target.files?.[0]?.text().then(setText)} />
+      </div>
+      <div className="row">
+        <span className="lb">Or paste</span>
+        <textarea className="yaml" rows={5} spellCheck={false} aria-label="Scheme YAML" placeholder={"scheme: \"One Dark\"\nbase00: \"282c34\"\n…"} value={text} onChange={(e) => setText(e.target.value)} />
+      </div>
+    </>
+  );
+}
+
+/** A surface drawn in the theme's own tokens: the words a page sets on it and one chip per status. */
+function Sample({ t }: { t: Record<string, string> }) {
+  return (
+    <div className="sample" data-theme-raw="" style={{ background: t.surface, borderColor: t.track }}>
+      <div style={{ color: t.ink }}>TASK-8943 · Admin theme picker <span style={{ color: t.muted }}>· 2h ago</span></div>
+      <div className="chips">
+        {DISTINCT.map((k) => (
+          <span key={k} style={{ color: t[`${k}-text`], borderColor: t[k] }}><i style={{ background: t[k] }} />{ROLE_LABEL[k]}</span>
+        ))}
+      </div>
+    </div>
+  );
+}
+
+function Nudges({ nudged }: { nudged: Nudge[] }) {
+  if (!nudged.length) return null;
+  return (
+    <div className="nudges">
+      <div className="k">Lifted to read on the surface</div>
+      <ul data-theme-raw="">
+        {nudged.map((x) => <li key={x.key}><span className="nk">{x.key}</span><i style={{ background: x.from }} /><code>{x.from}</code>→<i style={{ background: x.to }} /><code>{x.to}</code></li>)}
+      </ul>
+    </div>
+  );
+}
+
+function parse(text: string) {
+  if (!text.trim()) return null;
+  try {
+    return fromBase16(text);
+  } catch (e) {
+    return e instanceof Error ? e : new Error(String(e));
+  }
+}
+
+function ImportDialog({ theme, close }: { theme: ThemeStore; close: () => void }) {
+  const [text, setText] = useState("");
+  const [name, setName] = useState<string | null>(null);
+  const [withBg, setWithBg] = useState(true);
+  const parsed = useMemo(() => parse(text), [text]);
+  const scheme = parsed instanceof Error ? null : parsed;
+  const bgNo = scheme && bgRefusal(scheme.bg);
+  const useBg = !!scheme && withBg && !bgNo;
+  const built = useMemo(() => scheme && build(scheme.pack, useBg ? scheme.bg : theme.bgOf(theme.get().bg)), [scheme, useBg, theme]);
+  const [d, a, b] = built ? closest(built.t) : [Infinity, "", ""];
+  const refused = d < REFUSE_DE;
+  const save = () => {
+    if (!scheme || refused) return;
+    theme.addPack({ ...scheme.pack, name: (name ?? scheme.name).trim() || scheme.name }, useBg ? scheme.bg : undefined);
+    close();
+  };
+  return (
+    <Modal label="Import a color scheme" close={close}>
+      <div className="opt">
+        <SchemeSource text={text} setText={setText} />
+        {scheme && <>
+          <div className="row"><span className="lb">Name</span><input className="nmin" value={name ?? scheme.name} aria-label="Pack name" maxLength={40} onChange={(e) => setName(e.target.value)} /></div>
+          <div className="row">
+            <span className="lb">Background</span>
+            <label className={`withbg${bgNo ? " off" : ""}`}><input type="checkbox" checked={useBg} disabled={!!bgNo} onChange={(e) => setWithBg(e.target.checked)} /> Also add its background{scheme ? <Ramp n={scheme.bg} /> : null}</label>
+          </div>
+          {bgNo && <div className="note wide">{bgNo} The pack imports on your current background.</div>}
+        </>}
+      </div>
+      {parsed instanceof Error && <div className="refusal" role="alert"><div className="k">Not read</div>{parsed.message}</div>}
+      {built && <>
+        <Sample t={built.t} />
+        {refused
+          ? <div className="refusal" role="alert"><div className="k">Not imported</div>{ROLE_LABEL[a]} and {ROLE_LABEL[b]} are too alike to tell apart on the Star Map (ΔE {de(d)}; needs {de(REFUSE_DE)}).</div>
+          : d < WARN_DE
+            ? <div className="warn" role="status"><b>Close pair:</b> {ROLE_LABEL[a]} and {ROLE_LABEL[b]} are near (ΔE {de(d)}). It imports; check them on the map.</div>
+            : <div className="okline" role="status">Every status stands apart: the closest pair, {ROLE_LABEL[a]} and {ROLE_LABEL[b]}, is ΔE {de(d)}.</div>}
+        <Nudges nudged={built.nudged} />
+      </>}
+      <div className="afoot">
+        <button className="cancel" onClick={close}>Cancel</button>
+        <button className="startbtn sp" disabled={!scheme || refused} onClick={save}>Import and apply</button>
+      </div>
+    </Modal>
+  );
+}
+
+const HEX = /^#[0-9a-fA-F]{6}$/;
+
+function BgDialog({ theme, close }: { theme: ThemeStore; close: () => void }) {
+  const [from, setFrom] = useState<"color" | "scheme">("color");
+  const [pick, setPick] = useState("#2a1f3d");
+  const [draft, setDraft] = useState(pick);
+  const [text, setText] = useState("");
+  const [name, setName] = useState("");
+  const parsed = useMemo(() => (from === "scheme" ? parse(text) : null), [from, text]);
+  const n = from === "color" ? rampFrom(pick) : parsed && !(parsed instanceof Error) ? parsed.bg : null;
+  const refused = n && bgRefusal(n);
+  const built = useMemo(() => n && !refused ? build(theme.packOf(theme.get().pack), n) : null, [n && JSON.stringify(n), refused, theme]); // eslint-disable-line react-hooks/exhaustive-deps
+  const fallback = from === "color" ? `Background ${pick}` : parsed && !(parsed instanceof Error) ? parsed.name : "";
+  const save = () => {
+    if (!n || refused) return;
+    theme.addBg(name.trim() || fallback, n);
+    close();
+  };
+  const color = (v: string) => {
+    setDraft(v);
+    if (HEX.test(v)) setPick(v.toLowerCase());
+  };
+  return (
+    <Modal label="Add a background" close={close}>
+      <div className="opt">
+        <div className="row">
+          <span className="lb">From</span>
+          <div className="seg">
+            <button className={from === "color" ? "on" : ""} aria-pressed={from === "color"} onClick={() => setFrom("color")}>One color</button>
+            <button className={from === "scheme" ? "on" : ""} aria-pressed={from === "scheme"} onClick={() => setFrom("scheme")}>A scheme file</button>
+          </div>
+        </div>
+        {from === "color"
+          ? <div className="row">
+              <span className="lb">Surface</span>
+              <span className="pickc"><input type="color" value={pick} aria-label="Surface color" onChange={(e) => color(e.target.value)} /><input className="hexin" value={draft} aria-label="Surface hex" maxLength={7} onChange={(e) => color(e.target.value)} /><span className="hint">panels sit on it; the rest steps from it</span></span>
+            </div>
+          : <SchemeSource text={text} setText={setText} />}
+        {n && <div className="row"><span className="lb">Ramp</span><Ramp n={n} /></div>}
+        <div className="row"><span className="lb">Name</span><input className="nmin" value={name} placeholder={fallback} aria-label="Background name" maxLength={40} onChange={(e) => setName(e.target.value)} /></div>
+      </div>
+      {parsed instanceof Error && <div className="refusal" role="alert"><div className="k">Not read</div>{parsed.message}</div>}
+      {refused && <div className="refusal" role="alert"><div className="k">Not added</div>{refused}</div>}
+      {built && <>
+        <Sample t={built.t} />
+        <Nudges nudged={built.nudged} />
+      </>}
+      <div className="afoot">
+        <button className="cancel" onClick={close}>Cancel</button>
+        <button className="startbtn sp" disabled={!n || !!refused} onClick={save}>Add and apply</button>
+      </div>
+    </Modal>
+  );
+}
