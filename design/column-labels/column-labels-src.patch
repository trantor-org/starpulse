--- /dev/null
+++ b/starpulse/web/src/features/kanban/viewColumns.ts
@@ -0,0 +1,51 @@
+import { apiFetch } from "../../api/apiFetch";
+import type { Machine } from "../../api";
+
+/** The install's choice for one board state, set with `starpulse columns`: a label in place of the machine's name, and whether its column is drawn. */
+export interface ColumnPref {
+  id: string;
+  label: string | null;
+  hidden: boolean;
+}
+/** What serve stores for the install's one viewer (GET /api/views/columns): one row per state changed. The page only reads it. */
+export interface ViewColumns {
+  columns: ColumnPref[];
+}
+
+export const NONE: ViewColumns = { columns: [] };
+
+const prefOf = (v: ViewColumns, id: string): ColumnPref => v.columns.find((c) => c.id === id) ?? { id, label: null, hidden: false };
+export const labelOf = (v: ViewColumns, id: string): string | null => prefOf(v, id).label;
+export const hiddenOf = (v: ViewColumns, id: string): boolean => prefOf(v, id).hidden;
+
+/** The columns drawn: the machine's order, less the hidden ones. */
+export const shown = (v: ViewColumns, ids: string[]): string[] => ids.filter((id) => !hiddenOf(v, id));
+
+/** The machine with each state's name overlaid by its label: every name the page draws reads it, while writes keep the state id. */
+export function relabel(machine: Machine, v: ViewColumns): Machine {
+  if (!v.columns.some((c) => c.label)) return machine;
+  return { ...machine, states: machine.states.map((s) => ({ ...s, name: labelOf(v, s.id) ?? s.name })) };
+}
+
+const send = (url: string): Promise<Response> =>
+  ((globalThis as { __MOCK_FETCH__?: typeof apiFetch }).__MOCK_FETCH__ ?? apiFetch)(url);
+
+/** The page's one copy of the install's columns, read once at load. */
+class ViewColumnsStore {
+  private v: ViewColumns = NONE;
+  private fns = new Set<() => void>();
+  get = () => this.v;
+  subscribe = (fn: () => void) => {
+    this.fns.add(fn);
+    return () => void this.fns.delete(fn);
+  };
+  load = async () => {
+    const res = await send("/api/views/columns").catch(() => null);
+    if (res?.ok) {
+      this.v = (await res.json()) as ViewColumns;
+      for (const fn of this.fns) fn();
+    }
+  };
+}
+
+export const viewColumns = new ViewColumnsStore();
