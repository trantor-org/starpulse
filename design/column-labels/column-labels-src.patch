+import { apiFetch } from "../../api/apiFetch";
+import type { Machine } from "../../api";
+
+/** The viewer's own choice for one board state: a label in place of the machine's name, and whether its column is drawn. */
+export interface ColumnPref {
+  id: string;
+  label: string | null;
+  hidden: boolean;
+}
+/** What serve stores for the install's one viewer (GET/PUT /api/views/columns): one row per state changed, and the column order when moved. */
+export interface ViewColumns {
+  columns: ColumnPref[];
+  order: string[];
+}
+export type Saving = { state: "idle" | "saving" | "saved" } | { state: "refused"; reason: string; id?: string } | { state: "offline" };
+
+export const NONE: ViewColumns = { columns: [], order: [] };
+export const LABEL_MAX = 40;
+
+const prefOf = (v: ViewColumns, id: string): ColumnPref => v.columns.find((c) => c.id === id) ?? { id, label: null, hidden: false };
+export const labelOf = (v: ViewColumns, id: string): string | null => prefOf(v, id).label;
+export const hiddenOf = (v: ViewColumns, id: string): boolean => prefOf(v, id).hidden;
+
+/** `v` with `id`'s row changed; a row back at the machine's name and drawn is dropped, so an unchanged state stores nothing. */
+export function withPref(v: ViewColumns, id: string, change: Partial<Omit<ColumnPref, "id">>): ViewColumns {
+  const next = { ...prefOf(v, id), ...change };
+  const label = next.label?.trim() ? next.label : null;
+  const rows = v.columns.filter((c) => c.id !== id);
+  return { ...v, columns: label === null && !next.hidden ? rows : [...rows, { id, label, hidden: next.hidden }] };
+}
+
+/** The board's columns in the viewer's order: a state the order does not name keeps the machine's place after the ones it does. */
+export const ordered = (v: ViewColumns, ids: string[]): string[] => [...v.order.filter((id) => ids.includes(id)), ...ids.filter((id) => !v.order.includes(id))];
+/** The columns drawn: in the viewer's order, less the hidden ones. */
+export const arranged = (v: ViewColumns, ids: string[]): string[] => ordered(v, ids).filter((id) => !hiddenOf(v, id));
+/** `ids` with `id` moved by `by` places. */
+export const moved = (ids: string[], id: string, by: number): string[] => {
+  const at = ids.indexOf(id), to = Math.max(0, Math.min(ids.length - 1, at + by)), next = ids.filter((x) => x !== id);
+  next.splice(to, 0, id);
+  return next;
+};
+/** How many columns differ from the machine: relabeled, hidden or out of the machine's order. */
+export function changed(v: ViewColumns, ids: string[]): number {
+  const order = ordered(v, ids);
+  return ids.filter((id, i) => labelOf(v, id) !== null || hiddenOf(v, id) || order[i] !== id).length;
+}
+
+/** The machine with each state's name overlaid by the viewer's label: every name the page draws reads it, while writes keep the state id. */
+export function relabel(machine: Machine, v: ViewColumns): Machine {
+  if (!v.columns.some((c) => c.label)) return machine;
+  return { ...machine, states: machine.states.map((s) => ({ ...s, name: labelOf(v, s.id) ?? s.name })) };
+}
+
+const send = (url: string, init?: RequestInit): Promise<Response> =>
+  ((globalThis as { __MOCK_FETCH__?: typeof apiFetch }).__MOCK_FETCH__ ?? apiFetch)(url, init);
+
+/** The page's one copy of the viewer's columns: drawn at once on a change, saved after a pause in typing. */
+class ViewColumnsStore {
+  private v: ViewColumns = NONE;
+  /** What serve last accepted: a refused save draws this again, so a label serve would not keep never reaches the page. */
+  private kept: ViewColumns = NONE;
+  private s: Saving = { state: "idle" };
+  private fns = new Set<() => void>();
+  private timer = 0;
+  get = () => this.v;
+  saving = () => this.s;
+  subscribe = (fn: () => void) => {
+    this.fns.add(fn);
+    return () => void this.fns.delete(fn);
+  };
+  private emit() {
+    for (const fn of this.fns) fn();
+  }
+  load = async () => {
+    const res = await send("/api/views/columns").catch(() => null);
+    if (res?.ok) {
+      this.v = this.kept = (await res.json()) as ViewColumns;
+      this.emit();
+    }
+  };
+  set = (next: ViewColumns, wait = 600) => {
+    this.v = next;
+    this.s = { state: "saving" };
+    this.emit();
+    clearTimeout(this.timer);
+    this.timer = window.setTimeout(() => void this.save(), wait);
+  };
+  flush = () => {
+    if (this.s.state !== "saving") return;
+    clearTimeout(this.timer);
+    void this.save();
+  };
+  save = async () => {
+    const sent = this.v;
+    const res = await send("/api/views/columns", { method: "PUT", body: JSON.stringify(sent) }).catch(() => null);
+    if (!res) this.s = { state: "offline" };
+    else if (res.ok) {
+      this.kept = sent;
+      this.s = { state: "saved" };
+    } else {
+      const body = (await res.json().catch(() => ({}))) as { error?: string; id?: string };
+      this.v = this.kept;
+      this.s = { state: "refused", reason: body.error ?? `serve refused the save (${res.status})`, id: body.id };
+    }
+    this.emit();
+  };
+}
+
+export const viewColumns = new ViewColumnsStore();
