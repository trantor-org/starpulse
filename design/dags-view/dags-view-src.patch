+#dg .dcard.p-failed { border-color: rgba(251,113,133,.25); }
+#dg .dcard .top { display: flex; align-items: center; gap: 7px; min-width: 0; }
+#dg .nm { color: var(--ink); min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+#dg .dcard .nm { flex: 1; }
+#dg .last { flex: none; font-size: calc(10.5px * var(--fs)); color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
+#dg .last .hot, .dgm .hot { color: #fcd34d; font-weight: 400; } #dg .last .q { color: #93c5fd; font-weight: 400; } #dg .last .bad, .dgm .bad { color: #fda4af; }
+#dg .dcard .foot { display: flex; align-items: center; gap: 6px; font-size: calc(10px * var(--fs)); color: var(--muted); min-height: 18px; }
+#dg .pool { min-width: 0; overflow: hidden; text-overflow: ellipsis; font-family: "JetBrains Mono", ui-monospace, monospace; font-size: calc(10px * var(--fs)); color: #7c8aa3; white-space: nowrap; }
+.tie { flex: 0 1 auto; min-width: 0; display: inline-block; vertical-align: middle; padding: 0 6px; border-radius: 3px; line-height: 16px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
+  color: var(--tc, #c084fc); background: color-mix(in srgb, var(--tc, #c084fc) 12%, transparent); font-size: calc(10px * var(--fs)); }
+#dg .run, .dgm .run { all: unset; box-sizing: border-box; margin-left: auto; flex: none; cursor: pointer; display: grid; place-items: center; width: 22px; height: 18px; border-radius: 5px;
+  border: 1px solid rgba(52,211,153,.45); background: rgba(52,211,153,.08); color: #a7f3d0; font-size: calc(8.5px * var(--fs)); }
+#dg .run:hover:not(:disabled), #dg .run:focus-visible { background: rgba(52,211,153,.22); }
+#dg .run:disabled, .dgm .run:disabled { cursor: default; border-color: rgba(148,163,184,.14); background: none; color: #3f4c66; }
+#dg .dcard.dense { padding: 6px 8px 5px 9px; gap: 3px; }
+
+/* Atlas: a band per domain, a tile per DAG. */
+#dg #atlas { flex: 1; min-height: 0; overflow-y: auto; padding: 0 4px 24px; scrollbar-width: thin; scrollbar-color: rgba(148,163,184,.25) transparent; }
+#dg .band { margin-bottom: 18px; gap: 10px; }
+#dg .band > .bh { top: 0; margin: 0; padding: 8px 4px 7px; font-size: calc(11px * var(--fs)); letter-spacing: .2em; text-transform: uppercase; color: #94a3b8; background: rgba(6,10,20,.94); }
+#dg .band > .bh .census { margin-left: 8px; }
+#dg .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(calc(168px * var(--fs)), 1fr)); gap: 8px; }
+#dg .tile { position: relative; padding: 10px 10px 8px; border-radius: 8px; cursor: pointer; outline: none; border: 1px solid transparent; background: rgba(148,163,184,.025);
+  display: flex; flex-direction: column; gap: 5px; transition: background .15s, border-color .15s; }
