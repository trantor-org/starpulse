diff --git a/starpulse/web/src/Dags.tsx b/starpulse/web/src/Dags.tsx
new file mode 100644
index 0000000..6d76e17
--- /dev/null
+++ b/starpulse/web/src/Dags.tsx
@@ -0,0 +1,421 @@
+// DESIGN MOCKUP ONLY (DAGs view). A view of its own for the DAGs, beside the Kanban: a catalog, one row per DAG grouped by
+// domain, with its steps as a small constellation. It reuses the page's own elements (the Kanban's filter chips and menus, fold
+// headers, label chips and ▶ edge strip, the task modal's frame and Start button) and the Star Map's DAG colors (DAG_COLOR).
+// It reads the page's embedded capture directly and simulates Run now in the page; the slice that builds it plumbs both through the HUD.
+import { useEffect, useMemo, useState, type CSSProperties, type ReactNode } from "react";
+import { ChoiceMenu } from "./Kanban";
+import { DAG_COLOR } from "./renderer";
+import { BOARD_COLOR } from "./scene";
+import type { Cue, Dag, DagStep, Domain, Machine, Pool } from "./types";
+
+interface Src { dags: Dag[]; domains: Domain[]; pools: Pool[]; cues: Cue[]; flows: { name: string; machine: Machine }[]; now: number }
+type G = typeof globalThis & { __DAGS__?: Src; __FLOW_FIXTURE__?: Src; __DAG_RUNSAFE__?: string[]; __DAG_REFUSE__?: Record<string, string>; __DAG_LEDGER__?: Record<string, string> };
+const g = globalThis as G;
+const src = (): Src | null => g.__DAGS__ ?? g.__FLOW_FIXTURE__ ?? null;
+const LOADED = Date.now() / 1000;
+/** The capture's clock, moving from the moment the page loaded, so a demo opened days later reads as it did. */
+const nowS = () => (src()?.now ?? LOADED) + Date.now() / 1000 - LOADED;
+export const dagCount = () => src()?.dags.length ?? 0;
+
+type Phase = "running" | "queued" | "failed" | "idle" | "ok";
+const PHASES: [Phase, string][] = [["running", "Running"], ["failed", "Failing"], ["idle", "Not run"], ["ok", "Healthy"]];
+const short = (n: string) => n.replace(/^[^/]+\//, "");
+
+interface Sim { phase: "running" | "queued" | "done"; startedAt: number; step: number; runId: string; finishedAt?: number }
+interface Row { d: Dag; domain: string; runSafe: boolean; phase: Phase; steps: Record<string, string>; startedAt: number; finishedAt: number; step: string }
+
+const iso = (s: string) => (s ? Date.parse(s) / 1000 : 0);
+function ago(t: number) {
+  const s = Math.max(0, nowS() - t);
+  if (s < 45) return "just now";
+  if (s < 3600) return `${Math.round(s / 60)}m ago`;
+  if (s < 86400 * 2) return `${Math.round(s / 3600)}h ago`;
+  return `${Math.round(s / 86400)}d ago`;
+}
+function took(a: number, b: number) {
+  const s = Math.max(0, Math.round(b - a));
+  if (s < 60) return `${s}s`;
+  if (s < 3600) return `${Math.floor(s / 60)}m ${s % 60}s`;
+  return `${Math.floor(s / 3600)}h ${Math.floor((s % 3600) / 60)}m`;
+}
+
+function rows(s: Src, sims: Record<string, Sim>): Row[] {
+  const dom: Record<string, { domain: string; runSafe: boolean }> = {};
+  const safe = new Set(g.__DAG_RUNSAFE__ ?? []);
+  for (const d of s.domains) for (const x of d.dags) dom[x.name] = { domain: d.name, runSafe: x.runSafe || safe.has(x.name) };
+  return s.dags.map((d) => {
+    const sim = sims[d.name], run = d.active?.[0];
+    let phase: Phase = run || d.status === "running" ? "running" : d.status === "queued" ? "queued" : d.status === "failed" || d.status === "aborted" ? "failed" : d.status === "not_started" ? "idle" : "ok";
+    let steps = Object.fromEntries(d.steps.map((x) => [x.name, run?.steps[x.name] ?? x.status]));
+    let startedAt = iso(run?.startedAt ?? d.startedAt), finishedAt = iso(d.finishedAt), step = run?.step ?? "";
+    if (sim) {
+      startedAt = sim.startedAt;
+      if (sim.phase === "done") { phase = "ok"; finishedAt = sim.finishedAt!; steps = Object.fromEntries(d.steps.map((x) => [x.name, "succeeded"])); }
+      else {
+        phase = sim.phase;
+        finishedAt = 0;
+        step = sim.phase === "running" ? d.steps[sim.step]?.name ?? "" : "";
+        steps = Object.fromEntries(d.steps.map((x, i) => [x.name, sim.phase === "queued" ? "queued" : i < sim.step ? "succeeded" : i === sim.step ? "running" : "not_started"]));
+      }
+    }
+    return { d, domain: dom[d.name]?.domain ?? "Other", runSafe: dom[d.name]?.runSafe ?? false, phase, steps, startedAt, finishedAt, step };
+  });
+}
+const group = (p: Phase): Phase => (p === "queued" ? "running" : p);
+const RANK: Record<Phase, number> = { running: 0, queued: 1, failed: 2, idle: 3, ok: 4 };
+const order = (a: Row, b: Row) => RANK[a.phase] - RANK[b.phase] || b.finishedAt - a.finishedAt || a.d.name.localeCompare(b.d.name);
+
+/** Where a DAG touches the Board: the event it is cued by, the transitions it writes, the skill it launches. */
+/** `ev`: the state transition a DAG writes or is cued by, which has a Ledger hung from it on the Star Map. */
+interface Tie { kind: "cue" | "writes" | "launches" | "acts"; text: string; note: string; color: string; ev?: string }
+function ties(s: Src, name: string): Tie[] {
+  const out: Tie[] = [];
+  const board = s.flows.find((f) => f.name === "board")?.machine;
+  const sn = (m: Machine, id: string) => m.states.find((x) => x.id === id)?.name ?? id;
+  for (const c of s.cues ?? []) if (c.dag === name) out.push({ kind: "cue", ev: c.event, text: `on ${c.event}`, note: `${c.on}; the task lands in ${board ? sn(board, c.state) : c.state}`, color: BOARD_COLOR[c.state] ?? "#94a3b8" });
+  for (const f of s.flows) {
+    const m = f.machine;
+    for (const [ev, ws] of Object.entries(m.writers ?? {})) if (ws.some((w) => w.actor === name)) {
+      const t = m.transitions.find((x) => x.event === ev);
+      out.push({ kind: "writes", ev: t ? ev : undefined, text: t ? sn(m, t.target) : ev, note: t ? `${ev}: ${sn(m, t.source)} → ${sn(m, t.target)}${f.name === "board" ? "" : ` (${f.name})`}` : ev, color: (t && BOARD_COLOR[t.target]) ?? "#a78bfa" });
+    }
+    const l = m.launches?.[name];
+    if (l) out.push({ kind: "launches", text: l.skill, note: l.flow ? `launches ${l.skill}, which runs the ${l.flow} machine` : `launches ${l.skill}`, color: "#a78bfa" });
+  }
+  if (board?.dagActors?.includes(name) && !out.some((t) => t.kind === "writes")) out.push({ kind: "acts", text: "Board", note: "acts on Board tasks", color: "#a78bfa" });
+  const seen = new Set<string>();
+  out.sort((a, b) => Number(!a.ev) - Number(!b.ev));
+  return out.filter((t) => !seen.has(t.kind + t.text + (t.ev ?? "")) && seen.add(t.kind + t.text + (t.ev ?? "")));
+}
+
+/** Steps placed by depth (longest path from a root): one column per depth, a wide fan folded into a small cluster of
+ *  `rows`-high sub-columns `sub` apart, the columns spread `gap` apart at most so the whole fits `w`. With `px` (a label's width
+ *  per character) each gap first makes room for its two columns' names: in full beside a stacked column, and in half between two
+ *  single steps, whose names then alternate above and below. */
+function place(steps: DagStep[], w: number, h: number, pad: number, rows: number, sub: number, gap: number, gy: number, px = 0) {
+  const by = Object.fromEntries(steps.map((x) => [x.name, x]));
+  const depth: Record<string, number> = {};
+  const dep = (n: string, seen = new Set<string>()): number => {
+    if (n in depth) return depth[n];
+    if (seen.has(n)) return 0;
+    seen.add(n);
+    return (depth[n] = Math.max(0, ...(by[n]?.depends ?? []).filter((p) => by[p]).map((p) => dep(p, seen) + 1)));
+  };
+  steps.forEach((x) => dep(x.name));
+  const cols: string[][] = [];
+  for (const x of steps) (cols[depth[x.name]] ??= []).push(x.name);
+  const span = cols.map((c) => (Math.ceil(c.length / rows) - 1) * sub);
+  const lw = cols.map((c) => px * Math.max(...c.map((n) => n.length)));
+  const lone = (d: number) => cols[d].length === 1;
+  const floor = cols.slice(1).map((_, i) => !px ? sub : lone(i) && lone(i + 1) ? Math.max(9.5 * px, (lw[i] + lw[i + 1]) / 4 + 8) : (lw[i] + lw[i + 1]) / 2 + 14);
+  const extra = Math.max(0, w - 2 * pad - span.reduce((a, b) => a + b, 0) - floor.reduce((a, b) => a + b, 0)) / Math.max(1, floor.length);
+  const gx = floor.map((f) => f + Math.min(extra, Math.max(0, gap - f)));
+  const alt = !!px && gx.some((g, i) => lone(i) && lone(i + 1) && g < (lw[i] + lw[i + 1]) / 2 + 8);
+  const at: Record<string, { x: number; y: number }> = {};
+  let x0 = pad;
+  cols.forEach((c, d) => {
+    const n = Math.min(rows, c.length);
+    c.forEach((name, i) => (at[name] = { x: x0 + Math.floor(i / rows) * sub, y: h / 2 + ((i % rows) - (Math.min(n, c.length - Math.floor(i / rows) * rows) - 1) / 2) * gy }));
+    x0 += span[d] + (gx[d] ?? 0);
+  });
+  const up = (name: string) => alt && lone(depth[name]) && depth[name] % 2 === 1;
+  return { at, up, cols: cols.length, wide: Math.max(1, ...cols.map((c) => Math.min(rows, c.length))), span: x0 + pad };
+}
+
+/** The modal's chart: names sized by the page's text scale, a folded fan's sub-columns a longest name apart. */
+const LABEL_PX = () => 6.1 * (Number(getComputedStyle(document.documentElement).getPropertyValue("--fs")) || 1);
+const bigPlace = (steps: DagStep[], w: number, h: number) => {
+  const px = LABEL_PX(), lw = px * Math.max(0, ...steps.map((x) => x.name.length));
+  return place(steps, w, h, Math.max(44, lw / 2 + 6), 5, Math.max(92, lw + 16), 120, 40, px);
+};
+
+/** A name cut to `n` characters with an ellipsis: the strip draws outside its box so a halo is never clipped, so its text must fit. */
+const fit = (t: string, n: number) => (t.length <= n ? t : `${t.slice(0, Math.max(1, Math.floor(n) - 1))}…`);
+
+/** A DAG's steps as a constellation: one star per step in its status colour, joined by its dependencies; the running step burns. */
+function Strip({ r, w = 240, h = 24, big = false, center = false }: { r: Row; w?: number; h?: number; big?: boolean; center?: boolean }) {
+  const st = r.d.steps;
+  const p = big ? bigPlace(st, w, h - 12) : place(st, w, h, 7, 3, 5.5, 34, Math.min(7, (h - 6) / 2));
+  const dx = center ? (w - p.span) / 2 : 0;
+  const x = (n: string) => p.at[n].x + dx, y = (n: string) => p.at[n].y;
+  const rr = big ? 6 : (st.length > 9 ? 2.1 : 2.8) * (center ? 1.25 : 1);
+  return (
+    <svg className={`dstrip${big ? " big" : ""}`} width={big ? w : "100%"} height={h} viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="xMinYMid meet" aria-hidden={!big}>
+      {st.flatMap((s) => s.depends.filter((d) => p.at[d]).map((d) => (
+        <line key={d + ">" + s.name} x1={x(d)} y1={y(d)} x2={x(s.name)} y2={y(s.name)} className={r.steps[s.name] === "running" ? "e hot" : "e"} />
+      )))}
+      {st.map((s) => {
+        const v = r.steps[s.name] ?? "not_started", c = DAG_COLOR[v] ?? "#334155";
+        return (
+          <g key={s.name} className={`sd s-${v}`}>
+            {v === "running" && <circle cx={x(s.name)} cy={y(s.name)} r={rr * 2.6} fill={c} className="halo" />}
+            <circle cx={x(s.name)} cy={y(s.name)} r={v === "running" ? rr * 1.2 : rr} fill={v === "not_started" ? "#0b1220" : c} stroke={v === "not_started" ? "#475569" : "none"} strokeWidth={big ? 1.2 : 0.8} />
+            {s.kind === "agent" && <circle cx={x(s.name)} cy={y(s.name)} r={rr + (big ? 4 : 2)} fill="none" stroke="#a78bfa" strokeWidth={big ? 1 : 0.7} />}
+            {big && <text x={x(s.name)} y={y(s.name) + (p.up(s.name) ? -14 : 22)} className={v === "running" ? "hot" : undefined}>{s.name}</text>}
+            {big && <title>{`${s.name}: ${v.replace("_", " ")}${s.kind ? ` (${s.kind} step)` : ""}`}</title>}
+          </g>
+        );
+      })}
+      {!big && !center && st.length === 1 && <text x={7 + 9} y={h / 2 + 3.5} className="one">{fit(st[0].name, (w - 22) / (LABEL_PX() * 0.88))}</text>}
+    </svg>
+  );
+}
+
+/** A DAG's state as a dot in the Star Map's DAG colors: amber and pulsing while it runs, a black hole when its last run failed, hollow before its first run. */
+const Body = ({ phase, big }: { phase: Phase; big?: boolean }) => <i className={`orb o-${phase}${big ? " big" : ""}`} aria-hidden="true" />;
+
+function lastLine(r: Row) {
+  if (r.phase === "running") return <><b className="hot">{r.step || "starting"}</b> · {took(r.startedAt, nowS())}</>;
+  if (r.phase === "queued") return <b className="q">queued</b>;
+  if (r.phase === "idle") return "never run";
+  if (r.phase === "failed") {
+    const at = Object.entries(r.steps).find(([, v]) => v === "failed" || v === "aborted")?.[0];
+    return <><span className="bad">{r.d.status === "aborted" ? "aborted" : "failed"}{at ? ` at ${at}` : ""}</span> · {ago(r.finishedAt)}</>;
+  }
+  return <>{ago(r.finishedAt)} · {took(r.startedAt, r.finishedAt)}</>;
+}
+
+interface Ctx { s: Src; pools: Record<string, Pool>; run: (r: Row) => void; open: (r: Row) => void; why: (r: Row) => string | null }
+const poolText = (c: Ctx, r: Row) => {
+  const p = c.pools[r.d.pool ?? ""];
+  return p ? `${short(p.name)} ${p.running}/${p.cap}${p.queued ? ` +${p.queued}` : ""}` : "";
+};
+
+/** Run now: the Kanban's ▶ edge strip on a run-safe DAG's row (none on the rest, as on a card that cannot start), the task modal's Start button in the DAG modal. */
+function RunBtn({ c, r, label }: { c: Ctx; r: Row; label?: boolean }) {
+  const why = c.why(r);
+  if (!label && !r.runSafe) return null;
+  return (
+    <button className={label ? "startbtn" : "play edge"} disabled={!!why} title={why ?? `Run ${short(r.d.name)} now`} aria-label={`Run ${short(r.d.name)} now`}
+      onClick={(e) => { e.stopPropagation(); c.run(r); }}>▶{label && " Run now"}</button>
+  );
+}
+
+/** A Board tie as a chip; a state tie opens that transition's Ledger on the Star Map (here, the mockup's Ledger where one exists). */
+function TieChip({ t, dot, label }: { t: Tie; dot?: boolean; label?: string }) {
+  const url = t.ev ? (globalThis as G).__DAG_LEDGER__?.[t.ev] : undefined, text = dot ? "⇢" : `⇢ ${label ?? t.text}`;
+  const title = `${dot ? "Board: " : ""}${t.note}${t.ev ? `. Opens the ${t.ev} Ledger${url ? "" : " (not mocked yet)"}` : ""}`;
+  const cls = `tie${dot ? " dot" : ""}${t.ev ? " lg" : ""}`, st = { "--tc": t.color } as CSSProperties;
+  return url ? <a className={cls} href={url} target="_blank" rel="noreferrer" title={title} style={st} onClick={(e) => e.stopPropagation()}>{text}</a>
+    : <span className={cls} title={title} style={st}>{text}</span>;
+}
+
+function Fold({ k, title, n, folded, toggle, glyph, children, className }: { k: string; title: ReactNode; n: number; folded: Set<string>; toggle: (k: string) => void; glyph?: ReactNode; children: ReactNode; className?: string }) {
+  const f = folded.has(k);
+  return (
+    <div className={`bucket${f ? " folded" : ""}${className ? ` ${className}` : ""}`}>
+      <div className="bh" onClick={() => toggle(k)} role="button" tabIndex={0} aria-expanded={!f}
+        onKeyDown={(e) => (e.key === "Enter" || e.key === " ") && (e.preventDefault(), toggle(k))}><span className="tw">▾</span>{glyph}<span className="bn">{title}</span><span className="c">{n}</span></div>
+      {!f && children}
+    </div>
+  );
+}
+
+const Census = ({ rs }: { rs: Row[] }) => (
+  <span className="census">
+    {PHASES.filter(([p]) => p !== "ok").map(([p, l]) => {
+      const n = rs.filter((r) => group(r.phase) === p).length;
+      return n ? <span key={p} title={`${n} ${l.toLowerCase()}`}><Body phase={p} />{n}</span> : null;
+    })}
+  </span>
+);
+
+function Catalog({ c, rs, folded, toggle }: { c: Ctx; rs: Row[]; folded: Set<string>; toggle: (k: string) => void }) {
+  const doms = [...new Set([...c.s.domains.map((d) => d.name), ...rs.map((r) => r.domain)])].filter((d) => rs.some((r) => r.domain === d));
+  return (
+    <div id="catalog">
+      <div className="thead"><span /><span>DAG</span><span>Steps</span><span>Last run</span><span>Pool</span><span>Board</span><span /></div>
+      {doms.map((d) => {
+        const list = rs.filter((r) => r.domain === d).sort(order);
+        return (
+          <Fold key={d} k={`cat|${d}`} title={<>{d} <Census rs={list} /></>} n={list.length} folded={folded} toggle={toggle}>
+            {list.map((r) => {
+              const t = ties(c.s, r.d.name)[0];
+              return (
+                <div key={r.d.name} className={`trow p-${r.phase}${r.runSafe ? " startable" : ""}`} tabIndex={0} onClick={() => c.open(r)} onKeyDown={(e) => e.key === "Enter" && c.open(r)}>
+                  <Body phase={r.phase} /><span className="nm" title={r.d.name}>{short(r.d.name)}</span><Strip r={r} w={220} h={20} />
+                  <span className="last">{lastLine(r)}</span><span className="pool">{poolText(c, r) || "—"}</span>
+                  <span>{t ? <TieChip t={t} /> : <span className="none">—</span>}</span>
+                  <RunBtn c={c} r={r} />
+                </div>
+              );
+            })}
+          </Fold>
+        );
+      })}
+    </div>
+  );
+}
+
+function Modal({ c, r, close, refusal }: { c: Ctx; r: Row; close: () => void; refusal: string | null }) {
+  useEffect(() => {
+    const k = (e: KeyboardEvent) => e.key === "Escape" && close();
+    addEventListener("keydown", k);
+    return () => removeEventListener("keydown", k);
+  }, [close]);
+  const ts = ties(c.s, r.d.name), p = c.pools[r.d.pool ?? ""], why = c.why(r), fit = bigPlace(r.d.steps, 0, 100);
+  const w = Math.max(924, fit.span), h = Math.max(110, 74 + (fit.wide - 1) * 40);
+  return (
+    <div id="kbm" onClick={(e) => e.target === e.currentTarget && close()}>
+      <div className="modal tv dgm" role="dialog" aria-label={r.d.name}>
+        <button className="x" onClick={close} aria-label="Close">✕</button>
+        <div className="tvhead">
+          <div className="ttl">
+            <h2><Body phase={r.phase} big />{short(r.d.name)}</h2>
+            <div className="k">{r.d.name} · {r.phase === "ok" ? "healthy" : r.phase === "idle" ? "never run" : r.phase === "failed" ? r.d.status : r.phase} · {r.domain}{r.d.pool ? ` · pool ${short(r.d.pool)}` : ""}</div>
+          </div>
+          <div className="acts" />
+        </div>
+        <div className="tvbody">
+          {refusal && <div className="editrefusal"><b>Run refused.</b> {refusal}</div>}
+          <section className="sec"><div className="sh"><span className="t">Steps</span><span className="n">{r.d.steps.length}</span></div>
+            <div className="chart"><Strip r={r} w={w} h={h} big /></div>
+          </section>
+          <table><tbody>
+            <tr><td>{r.phase === "running" || r.phase === "queued" ? "this run" : "last run"}</td><td>{lastLine(r)}</td></tr>
+            <tr><td>started</td><td>{r.startedAt ? `${new Date(r.startedAt * 1000).toLocaleString([], { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })} (${ago(r.startedAt)})` : "—"}</td></tr>
+            <tr><td>run</td><td className="mono">{r.d.runId || "—"}{(r.d.active?.length ?? 0) > 1 ? ` + ${r.d.active!.length - 1} more` : ""}</td></tr>
+            <tr><td>queue</td><td>{p ? <span className="slots">{Array.from({ length: Math.min(p.cap, 12) }, (_, i) => <i key={i} className={i < p.running ? "on" : ""} />)}{p.cap > 12 && <em>…</em>}<span>{short(p.name)}: {p.running} of {p.cap} running{p.queued ? `, ${p.queued} queued` : ""}</span></span> : "no pool"}</td></tr>
+            <tr><td>run now</td><td>{why ? <span className="k">{why}</span> : "run-safe: StarPulse may start it"}</td></tr>
+          </tbody></table>
+          <section className="sec"><div className="sh"><span className="t">Board</span></div>
+            {ts.length ? ts.map((t) => <div className="tierow" key={t.kind + t.text + (t.ev ?? "")}><TieChip t={t} label={t.kind === "writes" ? `writes ${t.text}` : t.kind === "acts" ? "acts" : t.text} /><span className="k">{t.note}</span>
+              {t.ev && ((u) => u ? <a className="lgnote" href={u} target="_blank" rel="noreferrer">open the {t.ev} Ledger ↗</a>
+                : <span className="lgnote">{t.ev} Ledger: on the Star Map, not mocked yet</span>)((globalThis as G).__DAG_LEDGER__?.[t.ev])}</div>)
+              : <div className="k">No Board tie: this DAG neither moves a task nor is cued by one.</div>}
+          </section>
+        </div>
+        <div className="tvfoot">
+          <RunBtn c={c} r={r} label />
+        </div>
+      </div>
+    </div>
+  );
+}
+
+export function Dags() {
+  const s = src();
+  const [sims, setSims] = useState<Record<string, Sim>>({});
+  const [, tick] = useState(0);
+  const [q, setQ] = useState("");
+  const [only, setOnly] = useState<Phase | null>(null);
+  const [dom, setDom] = useState<string | null>(null);
+  const [menu, setMenu] = useState<"status" | "domain" | null>(null);
+  const [folded, setFolded] = useState<Set<string>>(new Set());
+  const [opened, setOpened] = useState<string | null>(null);
+  const [toast, setToast] = useState<{ text: string; at: number } | null>(null);
+  const [refusal, setRefusal] = useState<string | null>(null);
+
+  // the clock and the simulated runs: a step every 1.6 s (a run lasts 6 s at least), a queued run starting when its pool frees a slot
+  useEffect(() => {
+    const id = setInterval(() => {
+      tick((n) => n + 1);
+      setSims((all) => {
+        if (!Object.values(all).some((x) => x.phase !== "done")) return all;
+        const next = { ...all };
+        for (const [n, x] of Object.entries(next)) {
+          if (x.phase !== "running") continue;
+          const d = s!.dags.find((o) => o.name === n)!;
+          const step = Math.floor((nowS() - x.startedAt) / Math.max(1.6, 6 / d.steps.length));
+          next[n] = step >= d.steps.length ? { ...x, phase: "done", finishedAt: nowS() } : { ...x, step };
+        }
+        for (const [n, x] of Object.entries(next)) {
+          if (x.phase !== "queued") continue;
+          const d = s!.dags.find((o) => o.name === n)!, p = s!.pools.find((o) => o.name === d.pool);
+          const busy = (p?.running ?? 0) + Object.entries(next).filter(([m, y]) => y.phase === "running" && s!.dags.find((o) => o.name === m)?.pool === d.pool).length;
+          if (!p || busy < p.cap) next[n] = { ...x, phase: "running", startedAt: nowS(), step: 0 };
+        }
+        return next;
+      });
+    }, 400);
+    return () => clearInterval(id);
+  }, [s]);
+
+  // a toast shows for four seconds
+  useEffect(() => {
+    if (!toast) return;
+    const id = setTimeout(() => setToast(null), 4000);
+    return () => clearTimeout(id);
+  }, [toast]);
+
+  const all = useMemo(() => (s ? rows(s, sims) : []), [s, sims]);
+  const pools = useMemo(() => {
+    const out: Record<string, Pool> = {};
+    for (const p of s?.pools ?? []) {
+      const mine = all.filter((r) => r.d.pool === p.name && sims[r.d.name]);
+      out[p.name] = { ...p, running: p.running + mine.filter((r) => r.phase === "running").length, queued: p.queued + mine.filter((r) => r.phase === "queued").length };
+    }
+    return out;
+  }, [s, all, sims]);
+  if (!s) return <div id="dg"><header><span className="title">DAGs</span><span className="count">no DAGs read</span></header></div>;
+
+  const why = (r: Row) => {
+    if (r.phase === "running") return "Already running";
+    if (r.phase === "queued") return "Already queued";
+    if (!r.runSafe) return "Not run-safe: this DAG changes live state, so StarPulse will not start it. Run it from Dagu.";
+    return null;
+  };
+  const run = (r: Row) => {
+    const refused = g.__DAG_REFUSE__?.[r.d.name];
+    if (refused) { setToast({ text: `${short(r.d.name)}: ${refused}`, at: Date.now() }); setRefusal(refused); return; }
+    const p = pools[r.d.pool ?? ""], full = p && p.running >= p.cap;
+    setSims((x) => ({ ...x, [r.d.name]: { phase: full ? "queued" : "running", startedAt: nowS(), step: 0, runId: `run-${Date.now() % 100000}` } }));
+    setToast({ text: full ? `${short(r.d.name)} queued: pool ${short(p.name)} is full (${p.running}/${p.cap})` : `${short(r.d.name)} started`, at: Date.now() });
+  };
+  const c: Ctx = { s, pools, run, open: (r) => { setRefusal(null); setOpened(r.d.name); }, why };
+  const needle = q.trim().toLowerCase();
+  const rs = all.filter((r) => (!only || group(r.phase) === only) && (!dom || r.domain === dom) &&
+    (!needle || r.d.name.toLowerCase().includes(needle) || r.domain.toLowerCase().includes(needle) || r.d.steps.some((x) => x.name.toLowerCase().includes(needle))));
+  // the Kanban's filter chip: a label, the chosen value, ▾; a press opens its menu
+  const chip = (name: "status" | "domain", label: string, text: string | null) => (
+    <span className={`fchip${text !== null ? " set" : ""}`} role="button" tabIndex={0} aria-haspopup="menu" aria-expanded={menu === name}
+      onClick={() => setMenu((m) => (m === name ? null : name))} onKeyDown={(e) => e.key === "Enter" && setMenu((m) => (m === name ? null : name))}>
+      {label}{text !== null && <>: <b>{text}</b></>} ▾
+    </span>
+  );
+  const toggle = (k: string) => setFolded((f) => { const n = new Set(f); if (n.has(k)) n.delete(k); else n.add(k); return n; });
+  const open = opened ? all.find((r) => r.d.name === opened) : null;
+  const doms = new Set(all.map((r) => r.domain)).size;
+
+  return (
+    <div id="dg">
+      <header>
+        <span className="title">DAGs</span>
+        <span className="count">{all.length} DAGs · {doms} domains</span>
+        <span className="sky"><Census rs={all} /></span>
+      </header>
+      <div className="filters">
+        <div className="fw">
+          <input type="text" placeholder="filter by name, step or domain…" aria-label="Filter DAGs by name, step or domain" autoComplete="off" spellCheck={false} value={q} onChange={(e) => setQ(e.target.value)} onKeyDown={(e) => e.key === "Escape" && setQ("")} />
+        </div>
+        <div className="fw">
+          {chip("status", "Status", only && PHASES.find(([p]) => p === only)![1])}
+          {menu === "status" && <ChoiceMenu title="Status" options={PHASES.map(([p]) => ({ value: p, count: all.filter((r) => group(r.phase) === p).length }))} value={only}
+            name={(v) => PHASES.find(([p]) => p === v)![1]} set={(v) => setOnly(v as Phase | null)} close={() => setMenu(null)} />}
+        </div>
+        <div className="fw">
+          {chip("domain", "Domain", dom)}
+          {menu === "domain" && <ChoiceMenu title="Domain" options={[...new Set(all.map((r) => r.domain))].map((d) => ({ value: d, count: all.filter((r) => r.domain === d).length }))} value={dom}
+            name={(v) => v} set={setDom} close={() => setMenu(null)} />}
+        </div>
+        {(only || dom || q) && <button className="clear" onClick={() => { setOnly(null); setDom(null); setQ(""); }}>clear</button>}
+        <span className="shown">{rs.length === all.length ? `${all.length} shown` : `${rs.length} of ${all.length} shown`}</span>
+      </div>
+      {rs.length ? <Catalog c={c} rs={rs} folded={folded} toggle={toggle} /> : <div className="none">No DAG matches “{q}”.</div>}
+      {open && <Modal c={c} r={open} close={() => setOpened(null)} refusal={refusal} />}
+      {toast && <div className="dtoast" key={toast.at}>{toast.text}</div>}
+    </div>
+  );
+}
+
+export function DagLegend() {
+  return (
+    <>
+      <span><Body phase="running" />running</span><span><Body phase="ok" />healthy</span><br />
+      <span><Body phase="failed" />last run failed</span><span><Body phase="idle" />never run</span><br />
+      <span><svg width="26" height="8" aria-hidden="true"><line x1="3" y1="4" x2="23" y2="4" stroke="rgba(148,163,184,.35)" /><circle cx="3" cy="4" r="2.4" fill="#34d399" /><circle cx="13" cy="4" r="2.8" fill="#fbbf24" /><circle cx="23" cy="4" r="2.4" fill="#0b1220" stroke="#475569" /></svg> steps</span>
+      <span><svg width="10" height="10" aria-hidden="true"><circle cx="5" cy="5" r="2.4" fill="#34d399" /><circle cx="5" cy="5" r="4.3" fill="none" stroke="#a78bfa" strokeWidth=".8" /></svg> agent step</span><br />
+      <span><span style={{ color: "#a78bfa" }}>⇢</span> Board tie</span><span><span style={{ color: "#34d399" }}>▶</span> run-safe</span>
+    </>
+  );
+}
