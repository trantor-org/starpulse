+);
+
+function Domains({ c, rs, folded, toggle }: { c: Ctx; rs: Row[]; folded: Set<string>; toggle: (k: string) => void }) {
+  const doms = [...new Set([...c.s.domains.map((d) => d.name), ...rs.map((r) => r.domain)])].filter((d) => rs.some((r) => r.domain === d));
+  return (
+    <div id="dcols" className="scrollx" style={{ "--cols": doms.length } as CSSProperties}>
+      {doms.map((d) => {
+        const list = rs.filter((r) => r.domain === d).sort(order), hot = list.filter((r) => r.phase !== "ok"), ok = list.filter((r) => r.phase === "ok");
+        return (
+          <section className="col" key={d}>
+            <h2><i className="cg" /><span className="nm" title={d}>{d}</span><span className="c">{list.length}</span><Census rs={list} /></h2>
+            <div className="cbody">
+              {hot.map((r) => <Card key={r.d.name} c={c} r={r} />)}
+              {ok.length > 0 && <Fold k={`ok|${d}`} title="Healthy" n={ok.length} folded={folded} toggle={toggle} glyph={<Body phase="ok" />}>{ok.map((r) => <Card key={r.d.name} c={c} r={r} />)}</Fold>}
+            </div>
+          </section>
+        );
+      })}
+    </div>
+  );
+}
+
+function Status({ c, rs, folded, toggle }: { c: Ctx; rs: Row[]; folded: Set<string>; toggle: (k: string) => void }) {
+  return (
+    <div id="dcols" className="status">
+      {PHASES.map(([p, l]) => {
+        const list = rs.filter((r) => group(r.phase) === p).sort(order);
+        const doms = [...new Set(list.map((r) => r.domain))];
+        return (
+          <section className={`col c-${p}`} key={p}>
+            <h2><Body phase={p} big /><span className="nm">{l}</span><span className="c">{list.length}</span></h2>
+            <div className="cbody">
+              {!list.length && <div className="empty">{p === "failed" ? "No failing DAGs" : p === "running" ? "Nothing running" : "None"}</div>}
+              {doms.map((d) => (
+                <Fold key={d} k={`${p}|${d}`} title={d} n={list.filter((r) => r.domain === d).length} folded={folded} toggle={toggle} className={p === "ok" ? "grid2" : undefined}>
+                  <div className="cards">{list.filter((r) => r.domain === d).map((r) => <Card key={r.d.name} c={c} r={r} dense={p === "ok"} />)}</div>
+                </Fold>
+              ))}
+            </div>
+          </section>
+        );
+      })}
+    </div>
+  );
+}
+
+function Atlas({ c, rs, folded, toggle }: { c: Ctx; rs: Row[]; folded: Set<string>; toggle: (k: string) => void }) {
+  const doms = [...new Set([...c.s.domains.map((d) => d.name), ...rs.map((r) => r.domain)])].filter((d) => rs.some((r) => r.domain === d));
+  return (
+    <div id="atlas">
+      {doms.map((d) => {
+        const list = rs.filter((r) => r.domain === d).sort(order);
+        return (
+          <Fold key={d} k={`atlas|${d}`} title={<>{d} <Census rs={list} /></>} n={list.length} folded={folded} toggle={toggle} className="band" glyph={<i className="cg" />}>
+            <div className="tiles">
+              {list.map((r) => {
+                const t = ties(c.s, r.d.name)[0];
+                return (
+                  <div key={r.d.name} className={`tile p-${r.phase}`} tabIndex={0} onClick={() => c.open(r)} onKeyDown={(e) => e.key === "Enter" && c.open(r)}>
+                    <Strip r={r} w={150} h={44} center />
+                    <div className="nm" title={r.d.name}><Body phase={r.phase} />{short(r.d.name)}</div>
+                    <div className="last">{lastLine(r)}</div>
+                    {t && <TieChip t={t} dot />}
+                    <RunBtn c={c} r={r} />
+                  </div>
+                );
+              })}
+            </div>
+          </Fold>
+        );
+      })}
+    </div>
+  );
+}
+
+function Catalog({ c, rs, folded, toggle }: { c: Ctx; rs: Row[]; folded: Set<string>; toggle: (k: string) => void }) {
+  const doms = [...new Set([...c.s.domains.map((d) => d.name), ...rs.map((r) => r.domain)])].filter((d) => rs.some((r) => r.domain === d));
+  return (
+    <div id="catalog">
+      <div className="thead"><span /><span>DAG</span><span>Steps</span><span>Last run</span><span>Pool</span><span>Board</span><span /></div>
+      {doms.map((d) => {
+        const list = rs.filter((r) => r.domain === d).sort(order);
+        return (
+          <Fold key={d} k={`cat|${d}`} title={<>{d} <Census rs={list} /></>} n={list.length} folded={folded} toggle={toggle}>
+            {list.map((r) => {
+              const t = ties(c.s, r.d.name)[0];
+              return (
+                <div key={r.d.name} className={`trow p-${r.phase}`} tabIndex={0} onClick={() => c.open(r)} onKeyDown={(e) => e.key === "Enter" && c.open(r)}>
+                  <Body phase={r.phase} /><span className="nm" title={r.d.name}>{short(r.d.name)}</span><Strip r={r} w={220} h={20} />
+                  <span className="last">{lastLine(r)}</span><span className="pool">{poolText(c, r) || "—"}</span>
+                  <span>{t ? <TieChip t={t} /> : <span className="none">—</span>}</span>
+                  <RunBtn c={c} r={r} />
+                </div>
+              );
+            })}
+          </Fold>
+        );
+      })}
+    </div>
