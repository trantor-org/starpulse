+.body.big { width: 1.2em; height: 1.2em; }
+.body.b-running { background: radial-gradient(circle, #fffbeb 0 16%, #fcd34d 38%, #f59e0b 62%, rgba(251,191,36,0) 72%); box-shadow: 0 0 .7em .12em rgba(251,191,36,.45); animation: dg-burn 2.4s ease-in-out infinite; }
+.body.b-queued { background: radial-gradient(circle, #eff6ff 0 16%, #93c5fd 48%, rgba(147,197,253,0) 72%); box-shadow: 0 0 .5em rgba(147,197,253,.35); }
+.body.b-ok { background: radial-gradient(circle, #ecfdf5 0 14%, #34d399 46%, rgba(52,211,153,.12) 64%, rgba(52,211,153,0) 72%); box-shadow: 0 0 .45em rgba(52,211,153,.22); }
+.body.b-failed { background: radial-gradient(circle, #010205 0 46%, #fb7185 50% 57%, rgba(251,113,133,.28) 62%, rgba(251,113,133,0) 74%); box-shadow: 0 0 .55em rgba(251,113,133,.3); }
+.body.b-idle { background: radial-gradient(circle, rgba(148,163,184,.42) 0 34%, rgba(148,163,184,.12) 52%, rgba(148,163,184,0) 70%); box-shadow: inset 0 0 0 1px rgba(148,163,184,.18); }
+@keyframes dg-burn { 0%, 100% { box-shadow: 0 0 .55em .08em rgba(251,191,36,.4); } 50% { box-shadow: 0 0 1em .22em rgba(251,191,36,.6); } }
+@media (prefers-reduced-motion: reduce) { .body.b-running { animation: none; } }
+.census { display: inline-flex; gap: 10px; align-items: center; font-size: calc(10.5px * var(--fs)); color: var(--muted); font-variant-numeric: tabular-nums; letter-spacing: 0; text-transform: none; }
+.census > span { display: inline-flex; gap: 4px; align-items: center; }
+
+/* The constellation strip. */
+svg.strip { display: block; overflow: visible; }
+svg.strip .e { stroke: rgba(148,163,184,.32); stroke-width: .8; }
+svg.strip .e.hot { stroke: rgba(251,191,36,.55); }
+svg.strip .halo { opacity: .22; animation: dg-halo 1.6s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
+@keyframes dg-halo { 0%, 100% { opacity: .12; transform: scale(.75); } 50% { opacity: .32; transform: scale(1.1); } }
+@media (prefers-reduced-motion: reduce) { svg.strip .halo { animation: none; } }
+svg.strip text { font: calc(9.5px * var(--fs)) Inter, system-ui, sans-serif; fill: #6b7a93; }
+svg.strip.big .e { stroke-width: 1.2; }
+svg.strip.big text { font-size: calc(10.5px * var(--fs)); text-anchor: middle; fill: #94a3b8; }
+svg.strip.big text.hot { fill: #fde68a; }
+
+/* Columns (domains or states), as the Kanban's. */
+#dg #dcols { flex: 1; min-height: 0; display: grid; grid-template-columns: repeat(var(--cols, 5), minmax(250px, 1fr)); gap: 10px; padding-bottom: 16px; }
