+#kbm .dgm .ph.p-running { color: #fde68a; border-color: rgba(251,191,36,.45); } #kbm .dgm .ph.p-failed { color: #fda4af; border-color: rgba(251,113,133,.45); }
+#kbm .dgm .ph.p-ok { color: #a7f3d0; border-color: rgba(52,211,153,.35); } #kbm .dgm .ph.p-queued { color: #bfdbfe; border-color: rgba(147,197,253,.4); }
+#kbm .dgm .chart { overflow-x: auto; padding: 6px 0 2px; border-radius: 8px; background: radial-gradient(ellipse at 50% 50%, rgba(30,41,72,.35), transparent 75%); scrollbar-width: thin; }
