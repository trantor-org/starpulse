+#dg .dtoast { position: fixed; z-index: 45; bottom: 64px; left: 50%; transform: translateX(-50%); padding: 7px 14px; border-radius: 8px; background: rgba(12,19,34,.97); border: 1px solid rgba(148,163,184,.25);
+  color: var(--ink); font-size: calc(11.5px * var(--fs)); box-shadow: 0 10px 30px rgba(0,0,0,.5); animation: kb-modal .15s ease-out; }
+#legend .body { width: 9px; height: 9px; margin-right: 5px; }
