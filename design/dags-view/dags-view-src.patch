diff --git a/starpulse/web/src/Dags.tsx b/starpulse/web/src/Dags.tsx
new file mode 100644
index 0000000..93387e6
--- /dev/null
+++ b/starpulse/web/src/Dags.tsx
@@ -0,0 +1,489 @@
+// DESIGN MOCKUP ONLY (DAGs view). A view of its own for the DAGs, beside the Kanban: every DAG as a card or a tile in its
+// domain, drawn in the Star Map's language (a running DAG is a sun, a failed run collapses to a black hole, a DAG never run is a
+// dim body) with its steps as a small constellation. The layout is a review choice (`?layout=domains|status|atlas|catalog`).
+// It reads the page's embedded capture directly and simulates Run now in the page; the slice that builds it plumbs both through the HUD.
+import { useEffect, useMemo, useState, type CSSProperties, type ReactNode } from "react";
+import { BOARD_COLOR } from "./scene";
+import type { Cue, Dag, DagStep, Domain, Machine, Pool } from "./types";
+
+interface Src { dags: Dag[]; domains: Domain[]; pools: Pool[]; cues: Cue[]; flows: { name: string; machine: Machine }[]; now: number }
+type G = typeof globalThis & { __DAGS__?: Src; __FLOW_FIXTURE__?: Src; __DAG_LAYOUT__?: string; __DAG_RUNSAFE__?: string[]; __DAG_REFUSE__?: Record<string, string>; __DAG_LEDGER__?: Record<string, string> };
+const g = globalThis as G;
+const src = (): Src | null => g.__DAGS__ ?? g.__FLOW_FIXTURE__ ?? null;
+const LOADED = Date.now() / 1000;
+/** The capture's clock, moving from the moment the page loaded, so a demo opened days later reads as it did. */
+const nowS = () => (src()?.now ?? LOADED) + Date.now() / 1000 - LOADED;
+export const dagCount = () => src()?.dags.length ?? 0;
+
+type Phase = "running" | "queued" | "failed" | "idle" | "ok";
+const PHASES: [Phase, string][] = [["running", "Running"], ["failed", "Failing"], ["idle", "Not run"], ["ok", "Healthy"]];
+const STEP_COLOR: Record<string, string> = { running: "#fbbf24", queued: "#93c5fd", succeeded: "#34d399", failed: "#fb7185", aborted: "#94a3b8", skipped: "#64748b", not_started: "#334155" };
+const short = (n: string) => n.replace(/^[^/]+\//, "");
+
+interface Sim { phase: "running" | "queued" | "done"; startedAt: number; step: number; runId: string; finishedAt?: number }
+interface Row { d: Dag; domain: string; runSafe: boolean; phase: Phase; steps: Record<string, string>; startedAt: number; finishedAt: number; step: string }
+
+const iso = (s: string) => (s ? Date.parse(s) / 1000 : 0);
+function ago(t: number) {
+  const s = Math.max(0, nowS() - t);
+  if (s < 45) return "just now";
+  if (s < 3600) return `${Math.round(s / 60)}m ago`;
+  if (s < 86400 * 2) return `${Math.round(s / 3600)}h ago`;
+  return `${Math.round(s / 86400)}d ago`;
+}
+function took(a: number, b: number) {
+  const s = Math.max(0, Math.round(b - a));
+  if (s < 60) return `${s}s`;
+  if (s < 3600) return `${Math.floor(s / 60)}m ${s % 60}s`;
+  return `${Math.floor(s / 3600)}h ${Math.floor((s % 3600) / 60)}m`;
+}
+
+function rows(s: Src, sims: Record<string, Sim>): Row[] {
+  const dom: Record<string, { domain: string; runSafe: boolean }> = {};
+  const safe = new Set(g.__DAG_RUNSAFE__ ?? []);
+  for (const d of s.domains) for (const x of d.dags) dom[x.name] = { domain: d.name, runSafe: x.runSafe || safe.has(x.name) };
+  return s.dags.map((d) => {
+    const sim = sims[d.name], run = d.active?.[0];
+    let phase: Phase = run || d.status === "running" ? "running" : d.status === "queued" ? "queued" : d.status === "failed" || d.status === "aborted" ? "failed" : d.status === "not_started" ? "idle" : "ok";
+    let steps = Object.fromEntries(d.steps.map((x) => [x.name, run?.steps[x.name] ?? x.status]));
+    let startedAt = iso(run?.startedAt ?? d.startedAt), finishedAt = iso(d.finishedAt), step = run?.step ?? "";
+    if (sim) {
+      startedAt = sim.startedAt;
+      if (sim.phase === "done") { phase = "ok"; finishedAt = sim.finishedAt!; steps = Object.fromEntries(d.steps.map((x) => [x.name, "succeeded"])); }
+      else {
+        phase = sim.phase;
+        finishedAt = 0;
+        step = sim.phase === "running" ? d.steps[sim.step]?.name ?? "" : "";
+        steps = Object.fromEntries(d.steps.map((x, i) => [x.name, sim.phase === "queued" ? "queued" : i < sim.step ? "succeeded" : i === sim.step ? "running" : "not_started"]));
+      }
+    }
+    return { d, domain: dom[d.name]?.domain ?? "Other", runSafe: dom[d.name]?.runSafe ?? false, phase, steps, startedAt, finishedAt, step };
+  });
+}
+const group = (p: Phase): Phase => (p === "queued" ? "running" : p);
+const RANK: Record<Phase, number> = { running: 0, queued: 1, failed: 2, idle: 3, ok: 4 };
+const order = (a: Row, b: Row) => RANK[a.phase] - RANK[b.phase] || b.finishedAt - a.finishedAt || a.d.name.localeCompare(b.d.name);
+
+/** Where a DAG touches the Board: the event it is cued by, the transitions it writes, the skill it launches. */
+/** `ev`: the state transition a DAG writes or is cued by, which has a Ledger hung from it on the Star Map. */
+interface Tie { kind: "cue" | "writes" | "launches" | "acts"; text: string; note: string; color: string; ev?: string }
+function ties(s: Src, name: string): Tie[] {
+  const out: Tie[] = [];
+  const board = s.flows.find((f) => f.name === "board")?.machine;
+  const sn = (m: Machine, id: string) => m.states.find((x) => x.id === id)?.name ?? id;
+  for (const c of s.cues ?? []) if (c.dag === name) out.push({ kind: "cue", ev: c.event, text: `on ${c.event}`, note: `${c.on}; the task lands in ${board ? sn(board, c.state) : c.state}`, color: BOARD_COLOR[c.state] ?? "#94a3b8" });
+  for (const f of s.flows) {
+    const m = f.machine;
+    for (const [ev, ws] of Object.entries(m.writers ?? {})) if (ws.some((w) => w.actor === name)) {
+      const t = m.transitions.find((x) => x.event === ev);
+      out.push({ kind: "writes", ev: t ? ev : undefined, text: t ? sn(m, t.target) : ev, note: t ? `${ev}: ${sn(m, t.source)} → ${sn(m, t.target)}${f.name === "board" ? "" : ` (${f.name})`}` : ev, color: (t && BOARD_COLOR[t.target]) ?? "#c084fc" });
+    }
+    const l = m.launches?.[name];
+    if (l) out.push({ kind: "launches", text: l.skill, note: l.flow ? `launches ${l.skill}, which runs the ${l.flow} machine` : `launches ${l.skill}`, color: "#c084fc" });
+  }
+  if (board?.dagActors?.includes(name) && !out.some((t) => t.kind === "writes")) out.push({ kind: "acts", text: "Board", note: "acts on Board tasks", color: "#c084fc" });
+  const seen = new Set<string>();
+  out.sort((a, b) => Number(!a.ev) - Number(!b.ev));
+  return out.filter((t) => !seen.has(t.kind + t.text + (t.ev ?? "")) && seen.add(t.kind + t.text + (t.ev ?? "")));
+}
+
+/** Steps placed by depth (longest path from a root): one column per depth, a wide fan folded into a small cluster of
+ *  `rows`-high sub-columns `sub` apart, the columns spread `gap` apart at most so the whole fits `w`. With `px` (a label's width
+ *  per character) each gap first makes room for its two columns' names: in full beside a stacked column, and in half between two
+ *  single steps, whose names then alternate above and below. */
+function place(steps: DagStep[], w: number, h: number, pad: number, rows: number, sub: number, gap: number, gy: number, px = 0) {
+  const by = Object.fromEntries(steps.map((x) => [x.name, x]));
+  const depth: Record<string, number> = {};
+  const dep = (n: string, seen = new Set<string>()): number => {
+    if (n in depth) return depth[n];
+    if (seen.has(n)) return 0;
+    seen.add(n);
+    return (depth[n] = Math.max(0, ...(by[n]?.depends ?? []).filter((p) => by[p]).map((p) => dep(p, seen) + 1)));
+  };
+  steps.forEach((x) => dep(x.name));
+  const cols: string[][] = [];
+  for (const x of steps) (cols[depth[x.name]] ??= []).push(x.name);
+  const span = cols.map((c) => (Math.ceil(c.length / rows) - 1) * sub);
+  const lw = cols.map((c) => px * Math.max(...c.map((n) => n.length)));
+  const lone = (d: number) => cols[d].length === 1;
+  const floor = cols.slice(1).map((_, i) => !px ? sub : lone(i) && lone(i + 1) ? Math.max(9.5 * px, (lw[i] + lw[i + 1]) / 4 + 8) : (lw[i] + lw[i + 1]) / 2 + 14);
+  const extra = Math.max(0, w - 2 * pad - span.reduce((a, b) => a + b, 0) - floor.reduce((a, b) => a + b, 0)) / Math.max(1, floor.length);
+  const gx = floor.map((f) => f + Math.min(extra, Math.max(0, gap - f)));
+  const alt = !!px && gx.some((g, i) => lone(i) && lone(i + 1) && g < (lw[i] + lw[i + 1]) / 2 + 8);
+  const at: Record<string, { x: number; y: number }> = {};
+  let x0 = pad;
+  cols.forEach((c, d) => {
+    const n = Math.min(rows, c.length);
+    c.forEach((name, i) => (at[name] = { x: x0 + Math.floor(i / rows) * sub, y: h / 2 + ((i % rows) - (Math.min(n, c.length - Math.floor(i / rows) * rows) - 1) / 2) * gy }));
+    x0 += span[d] + (gx[d] ?? 0);
+  });
+  const up = (name: string) => alt && lone(depth[name]) && depth[name] % 2 === 1;
+  return { at, up, cols: cols.length, wide: Math.max(1, ...cols.map((c) => Math.min(rows, c.length))), span: x0 + pad };
+}
+
+/** The modal's chart: names sized by the page's text scale, a folded fan's sub-columns a longest name apart. */
+const LABEL_PX = () => 6.1 * (Number(getComputedStyle(document.documentElement).getPropertyValue("--fs")) || 1);
+const bigPlace = (steps: DagStep[], w: number, h: number) => {
+  const px = LABEL_PX(), lw = px * Math.max(0, ...steps.map((x) => x.name.length));
+  return place(steps, w, h, Math.max(44, lw / 2 + 6), 5, Math.max(92, lw + 16), 120, 40, px);
+};
+
+/** A name cut to `n` characters with an ellipsis: the strip draws outside its box so a halo is never clipped, so its text must fit. */
+const fit = (t: string, n: number) => (t.length <= n ? t : `${t.slice(0, Math.max(1, Math.floor(n) - 1))}…`);
+
+/** A DAG's steps as a constellation: one star per step in its status colour, joined by its dependencies; the running step burns. */
+function Strip({ r, w = 240, h = 24, big = false, center = false }: { r: Row; w?: number; h?: number; big?: boolean; center?: boolean }) {
+  const st = r.d.steps;
+  const p = big ? bigPlace(st, w, h - 12) : place(st, w, h, 7, 3, 5.5, 34, Math.min(7, (h - 6) / 2));
+  const dx = center ? (w - p.span) / 2 : 0;
+  const x = (n: string) => p.at[n].x + dx, y = (n: string) => p.at[n].y;
+  const rr = big ? 6 : (st.length > 9 ? 2.1 : 2.8) * (center ? 1.25 : 1);
+  return (
+    <svg className={`strip${big ? " big" : ""}`} width={big ? w : "100%"} height={h} viewBox={`0 0 ${w} ${h}`} preserveAspectRatio="xMinYMid meet" aria-hidden={!big}>
+      {st.flatMap((s) => s.depends.filter((d) => p.at[d]).map((d) => (
+        <line key={d + ">" + s.name} x1={x(d)} y1={y(d)} x2={x(s.name)} y2={y(s.name)} className={r.steps[s.name] === "running" ? "e hot" : "e"} />
+      )))}
+      {st.map((s) => {
+        const v = r.steps[s.name] ?? "not_started", c = STEP_COLOR[v] ?? "#334155";
+        return (
+          <g key={s.name} className={`sd s-${v}`}>
+            {v === "running" && <circle cx={x(s.name)} cy={y(s.name)} r={rr * 2.6} fill={c} className="halo" />}
+            <circle cx={x(s.name)} cy={y(s.name)} r={v === "running" ? rr * 1.2 : rr} fill={v === "not_started" ? "#0b1220" : c} stroke={v === "not_started" ? "#475569" : "none"} strokeWidth={big ? 1.2 : 0.8} />
+            {s.kind === "agent" && <circle cx={x(s.name)} cy={y(s.name)} r={rr + (big ? 4 : 2)} fill="none" stroke="#c4b5fd" strokeWidth={big ? 1 : 0.7} />}
+            {big && <text x={x(s.name)} y={y(s.name) + (p.up(s.name) ? -14 : 22)} className={v === "running" ? "hot" : undefined}>{s.name}</text>}
+            {big && <title>{`${s.name}: ${v.replace("_", " ")}${s.kind ? ` (${s.kind} step)` : ""}`}</title>}
+          </g>
+        );
+      })}
+      {!big && !center && st.length === 1 && <text x={7 + 9} y={h / 2 + 3.5} className="one">{fit(st[0].name, (w - 22) / (LABEL_PX() * 0.88))}</text>}
+    </svg>
+  );
+}
+
+/** A DAG's state as a body from the Star Map: a sun while it runs, a black hole when its last run failed, a dim body before its first run. */
+const Body = ({ phase, big }: { phase: Phase; big?: boolean }) => <i className={`body b-${phase}${big ? " big" : ""}`} aria-hidden="true" />;
+
+function lastLine(r: Row) {
+  if (r.phase === "running") return <><b className="hot">{r.step || "starting"}</b> · {took(r.startedAt, nowS())}</>;
+  if (r.phase === "queued") return <b className="q">queued</b>;
+  if (r.phase === "idle") return "never run";
+  if (r.phase === "failed") {
+    const at = Object.entries(r.steps).find(([, v]) => v === "failed" || v === "aborted")?.[0];
+    return <><span className="bad">{r.d.status === "aborted" ? "aborted" : "failed"}{at ? ` at ${at}` : ""}</span> · {ago(r.finishedAt)}</>;
+  }
+  return <>{ago(r.finishedAt)} · {took(r.startedAt, r.finishedAt)}</>;
+}
+
+interface Ctx { s: Src; pools: Record<string, Pool>; run: (r: Row) => void; open: (r: Row) => void; why: (r: Row) => string | null }
+const poolText = (c: Ctx, r: Row) => {
+  const p = c.pools[r.d.pool ?? ""];
+  return p ? `${short(p.name)} ${p.running}/${p.cap}${p.queued ? ` +${p.queued}` : ""}` : "";
+};
+
+function RunBtn({ c, r, label }: { c: Ctx; r: Row; label?: boolean }) {
+  const why = c.why(r);
+  return (
+    <button className={`run${label ? " lbl" : ""}`} disabled={!!why} title={why ?? `Run ${short(r.d.name)} now`} aria-label={`Run ${short(r.d.name)} now`}
+      onClick={(e) => { e.stopPropagation(); c.run(r); }}>▶{label && " Run now"}</button>
+  );
+}
+
+/** A Board tie as a chip; a state tie opens that transition's Ledger on the Star Map (here, the mockup's Ledger where one exists). */
+function TieChip({ t, dot, label }: { t: Tie; dot?: boolean; label?: string }) {
+  const url = t.ev ? (globalThis as G).__DAG_LEDGER__?.[t.ev] : undefined, text = dot ? "⇢" : `⇢ ${label ?? t.text}`;
+  const title = `${dot ? "Board: " : ""}${t.note}${t.ev ? `. Opens the ${t.ev} Ledger${url ? "" : " (not mocked yet)"}` : ""}`;
+  const cls = `tie${dot ? " dot" : ""}${t.ev ? " lg" : ""}`, st = { "--tc": t.color } as CSSProperties;
+  return url ? <a className={cls} href={url} target="_blank" rel="noreferrer" title={title} style={st} onClick={(e) => e.stopPropagation()}>{text}</a>
+    : <span className={cls} title={title} style={st}>{text}</span>;
+}
+
+function Card({ c, r, dense }: { c: Ctx; r: Row; dense?: boolean }) {
+  const t = ties(c.s, r.d.name)[0], pool = poolText(c, r);
+  return (
+    <div className={`dcard p-${r.phase}${dense ? " dense" : ""}`} tabIndex={0} onClick={() => c.open(r)} onKeyDown={(e) => e.key === "Enter" && c.open(r)}>
+      <div className="top"><Body phase={r.phase} /><span className="nm" title={r.d.name}>{short(r.d.name)}</span><span className="last">{lastLine(r)}</span></div>
+      <Strip r={r} />
+      <div className="foot">
+        {pool && <span className="pool" title={`pool ${r.d.pool}: running/cap +queued`}>{pool}</span>}
