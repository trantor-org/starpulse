+
+function Fold({ k, title, n, folded, toggle, glyph, children, className }: { k: string; title: ReactNode; n: number; folded: Set<string>; toggle: (k: string) => void; glyph?: ReactNode; children: ReactNode; className?: string }) {
+  const f = folded.has(k);
