+}
+
+function Modal({ c, r, close, refusal }: { c: Ctx; r: Row; close: () => void; refusal: string | null }) {
+  useEffect(() => {
+    const k = (e: KeyboardEvent) => e.key === "Escape" && close();
+    addEventListener("keydown", k);
+    return () => removeEventListener("keydown", k);
+  }, [close]);
+  const ts = ties(c.s, r.d.name), p = c.pools[r.d.pool ?? ""], why = c.why(r), fit = bigPlace(r.d.steps, 0, 100);
+  const w = Math.max(924, fit.span), h = Math.max(110, 74 + (fit.wide - 1) * 40);
+  return (
+    <div id="kbm" onClick={(e) => e.target === e.currentTarget && close()}>
+      <div className="modal tv dgm" role="dialog" aria-label={r.d.name}>
+        <button className="x" onClick={close} aria-label="Close">✕</button>
+        <div className="tvhead">
+          <div className="ttl">
+            <h2><Body phase={r.phase} big />{short(r.d.name)}</h2>
+            <div className="k">{r.d.name} · {r.domain}{r.d.pool ? ` · pool ${short(r.d.pool)}` : ""}</div>
+          </div>
+          <div className="acts"><span className={`ph p-${r.phase}`}>{r.phase === "ok" ? "healthy" : r.phase === "idle" ? "not run" : r.phase === "failed" ? r.d.status : r.phase}</span></div>
+        </div>
+        <div className="tvbody">
+          {refusal && <div className="editrefusal"><b>Run refused.</b> {refusal}</div>}
+          <section className="sec"><div className="sh"><span className="t">Steps</span><span className="n">{r.d.steps.length}</span></div>
+            <div className="chart"><Strip r={r} w={w} h={h} big /></div>
+          </section>
+          <table><tbody>
+            <tr><td>{r.phase === "running" || r.phase === "queued" ? "this run" : "last run"}</td><td>{lastLine(r)}</td></tr>
+            <tr><td>started</td><td>{r.startedAt ? `${new Date(r.startedAt * 1000).toLocaleString([], { month: "short", day: "numeric", hour: "2-digit", minute: "2-digit" })} (${ago(r.startedAt)})` : "—"}</td></tr>
+            <tr><td>run</td><td className="mono">{r.d.runId || "—"}{(r.d.active?.length ?? 0) > 1 ? ` + ${r.d.active!.length - 1} more` : ""}</td></tr>
+            <tr><td>queue</td><td>{p ? <span className="slots">{Array.from({ length: Math.min(p.cap, 12) }, (_, i) => <i key={i} className={i < p.running ? "on" : ""} />)}{p.cap > 12 && <em>…</em>}<span>{short(p.name)}: {p.running} of {p.cap} running{p.queued ? `, ${p.queued} queued` : ""}</span></span> : "no pool"}</td></tr>
+            <tr><td>run now</td><td>{why ? <span className="k">{why}</span> : "run-safe: StarPulse may start it"}</td></tr>
+          </tbody></table>
+          <section className="sec"><div className="sh"><span className="t">Board</span></div>
+            {ts.length ? ts.map((t) => <div className="tierow" key={t.kind + t.text + (t.ev ?? "")}><TieChip t={t} label={t.kind === "writes" ? `writes ${t.text}` : t.kind === "acts" ? "acts" : t.text} /><span className="k">{t.note}</span>
+              {t.ev && ((u) => u ? <a className="lgnote" href={u} target="_blank" rel="noreferrer">open the {t.ev} Ledger ↗</a>
+                : <span className="lgnote">{t.ev} Ledger: on the Star Map, not mocked yet</span>)((globalThis as G).__DAG_LEDGER__?.[t.ev])}</div>)
+              : <div className="k">No Board tie: this DAG neither moves a task nor is cued by one.</div>}
+          </section>
+        </div>
+        <div className="tvfoot">
+          <RunBtn c={c} r={r} label />
+        </div>
+      </div>
+    </div>
+  );
