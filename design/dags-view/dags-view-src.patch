+#dg #dcols.status { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.7fr); }
+#dg .col { min-height: 0; display: flex; flex-direction: column; border-radius: 10px; background: rgba(148,163,184,.035); border: 1px solid rgba(148,163,184,.08); }
+#dg .col h2 { margin: 0; flex: none; display: flex; align-items: center; gap: 8px; padding: 12px 12px 10px; font-size: calc(11px * var(--fs)); font-weight: 500; letter-spacing: .2em;
+  text-transform: uppercase; color: #94a3b8; border-bottom: 1px solid rgba(148,163,184,.08); white-space: nowrap; letter-spacing: .14em; }
+#dg .col h2 .nm { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
