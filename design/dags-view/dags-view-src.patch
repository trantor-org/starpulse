+#dg #catalog .bh { top: 26px; margin: 0; padding: 8px 10px 6px; }
+#dg .trow { display: grid; grid-template-columns: var(--grid); gap: 12px; align-items: center; padding: 2px 10px; min-height: 26px; line-height: 1.3; border-bottom: 1px solid rgba(148,163,184,.05); cursor: pointer; outline: none; }
