+/* DESIGN MOCKUP ONLY: the DAGs view. It shares the Kanban's frame, filters, menus, folds and ▶ edge strip (the :is(#kb, #dg)
+   rules above) and the task modal's frame and Start button; its colours are the Star Map's DAG colours. What follows is only
+   what the Kanban has no element for: the state dot, the step strip and the catalog's rows. */
+body.dags { background: radial-gradient(ellipse at 40% 30%, #0b1224 0%, var(--bg0) 70%); }
+body.dags canvas, body.dags #tip, body.dags #panel { visibility: hidden; }
+#nav .dg-glyph { border: 0; border-radius: 0; fill: currentColor; stroke: currentColor; stroke-width: .7; }
+#nav .dg-glyph path { fill: none; opacity: .55; }
+#nav.folded ~ #dg { left: calc(var(--nav-fold) + 20px); }
+#dg header .sky { margin-left: 6px; }
+#dg > .none { margin: 60px auto; color: var(--muted); }
+
+/* A DAG's state: the Kanban's machine dot in the DAG colours, the running one pulsing as a live session's does; a failed run
+   is a black hole (the page's ground ringed in rose), one never run a hollow step. Sized in em so it follows the text size. */
+.orb { flex: none; display: inline-block; box-sizing: border-box; width: .58em; height: .58em; border-radius: 50%; vertical-align: .02em; }
+.orb.big { width: .8em; height: .8em; }
+.orb.o-running { background: #fbbf24; box-shadow: 0 0 0 3px rgba(251,191,36,.25), 0 0 10px #fbbf24; animation: kb-pulse 1.4s ease-in-out infinite; }
+.orb.o-queued { background: #93c5fd; box-shadow: 0 0 6px #93c5fd; }
+.orb.o-ok { background: #34d399; box-shadow: 0 0 6px rgba(52,211,153,.6); }
+.orb.o-failed { background: var(--bg0); border: 1.5px solid #fb7185; box-shadow: 0 0 6px rgba(251,113,133,.5); }
+.orb.o-idle { background: #0b1220; border: 1px solid #475569; }
+@media (prefers-reduced-motion: reduce) { .orb.o-running { animation: none; } }
+#dg .census, .dgm .census { display: inline-flex; gap: 10px; align-items: center; font-size: calc(10.5px * var(--fs)); color: var(--muted); font-variant-numeric: tabular-nums; letter-spacing: 0; text-transform: none; }
+#dg .census > span { display: inline-flex; gap: 4px; align-items: center; }
+
+/* The step strip: the Star Map's DAG steps, one dot per step in DAG_COLOR, joined by their dependencies. */
+svg.dstrip { display: block; overflow: visible; }
+svg.dstrip .e { stroke: rgba(148,163,184,.32); stroke-width: .8; }
+svg.dstrip .e.hot { stroke: rgba(251,191,36,.55); }
+svg.dstrip .halo { opacity: .22; animation: kb-pulse 1.4s ease-in-out infinite; }
+@media (prefers-reduced-motion: reduce) { svg.dstrip .halo { animation: none; } }
+svg.dstrip text { font: calc(9.5px * var(--fs)) Inter, system-ui, sans-serif; fill: var(--muted); }
+svg.dstrip.big .e { stroke-width: 1.2; }
+svg.dstrip.big text { font-size: calc(10.5px * var(--fs)); text-anchor: middle; fill: #94a3b8; }
+svg.dstrip.big text.hot { fill: #fbbf24; }
+
