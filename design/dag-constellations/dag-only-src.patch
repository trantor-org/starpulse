+// TASK-3014 design mockup switches, read from the address. Design-only: never committed to the page source.
+const q = typeof location === "undefined" ? new URLSearchParams() : new URLSearchParams(location.search);
+/** glyph: quiet (point-star constellation) | radiant (one star, a ray per step) | live (today's step graph).
+ *  free: sky (domain clusters in the Board's open sky) | marks (one mark per domain, opens the DAGs level) | live (one hangar). */
+const scale = (() => {
+  try {
+    return Number(JSON.parse(localStorage.getItem("fv.admin.prefs") || "{}").scale) || 100;
+  } catch {
+    return 100;
+  }
+})();
+/** T: the Admin text size as a factor, so the free-DAG placement keeps clear of labels at 125 and 150%. */
+export const MOCK = { glyph: q.get("glyph") || "quiet", free: q.get("free") || "sky", T: scale / 100 };
+export const hash = (s: string) => {
+  let h = 2166136261;
+  for (let i = 0; i < s.length; i++) h = Math.imul(h ^ s.charCodeAt(i), 16777619);
+  return ((h >>> 0) % 10000) / 10000;
+};
