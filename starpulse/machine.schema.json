{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StarPulse machine definition",
  "description": "A lifecycle machine declared under .starpulse/machines/. Guards are field matches on the triggering event or the name of a guard an adapter registers in Python; config holds no expressions or code.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "states", "events"],
  "properties": {
    "name": {"$ref": "#/$defs/name"},
    "source": {
      "description": "The third party that moves this machine, such as GitHub. Only that party's events move it; StarPulse observes, and the page draws the machine apart from one StarPulse's own actors move.",
      "type": "string",
      "minLength": 1
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/state"}
    },
    "events": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"$ref": "#/$defs/transition"}
      }
    },
    "bindings": {
      "description": "Adapter event name to the machine event it moves.",
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "writers": {
      "description": "Per machine event, who fires it: a bare actor (an agent, an operator) or a workflow as <instance>/<workflow>, with the trigger it fires through.",
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"$ref": "#/$defs/writer"}
      }
    },
    "cues": {
      "description": "The workflows a machine event cues, each with how its failure resolves.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cue"}
    },
    "tiers": {
      "description": "The state ids the Star Map draws at each stage, left to right; a tier's states stack in its cell.",
      "type": "array",
      "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identifier"}}
    },
    "main_line": {
      "description": "The state ids along the machine's axis, in order. A Board file without one draws its lanes in order.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "rests": {
      "description": "States drawn as where a lifecycle ends though the machine does not declare them final, because an event leaves them.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "subflows": {
      "description": "Machines that open under one of this machine's states, each a sibling file named by its stem.",
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/subflow"}
    },
    "launches": {
      "description": "Per launching workflow (its own name, or <instance>/<workflow>), the skill it starts and the sibling machine that skill draws.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/launch"}
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"},
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "initial": {"type": "boolean"},
        "final": {"type": "boolean"},
        "flow": {
          "description": "A machine file, relative to this one, that runs while this state is active. One level only.",
          "type": "string",
          "minLength": 1
        }
      },
      "not": {"required": ["flow", "final"]}
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
          ]
        },
        "to": {"type": "string"},
        "if": {"$ref": "#/$defs/guard"},
        "unless": {"$ref": "#/$defs/guard"},
        "action": {"$ref": "#/$defs/registered"}
      }
    },
    "writer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "trigger"],
      "properties": {
        "actor": {
          "description": "A bare actor name, or a workflow as <instance>/<workflow> naming a workflow a configured runs adapter lists.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+(/[A-Za-z0-9_./-]+)?$"
        },
        "trigger": {"type": "string", "minLength": 1}
      }
    },
    "subflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "flow", "exits"],
      "properties": {
        "state": {"$ref": "#/$defs/identifier"},
        "flow": {"description": "The sibling machine file's stem.", "type": "string", "minLength": 1},
        "exits": {
          "description": "Per final state of the inner machine, the event of this machine that leaves the state.",
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"}
        },
        "when": {"description": "What has to hold for the inner machine to run under the state.", "type": "string"}
      }
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["skill"],
      "properties": {
        "skill": {"type": "string", "minLength": 1},
        "flow": {"description": "The sibling machine file's stem; absent when the skill has no machine.", "type": "string", "minLength": 1}
      }
    },
    "cue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event", "dag", "on", "resolves"],
      "properties": {
        "event": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "dag": {
          "description": "The cued workflow as <instance>/<workflow>.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_./-]+$"
        },
        "on": {"description": "What the page says cues it, such as a push to main.", "type": "string", "minLength": 1},
        "resolves": {
          "description": "forced: a failed run stays pinned until a forced rerun. next: it clears on the next run of the DAG.",
          "enum": ["forced", "next"]
        },
        "grace": {
          "description": "Seconds after the event a run of the DAG may take to start before the page draws it overdue. Default 300.",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "registered": {
      "description": "The name of a guard or action an adapter registers in Python.",
      "type": "string",
      "pattern": "^[a-z_][a-z0-9_]*$"
    },
    "guard": {
      "oneOf": [
        {"$ref": "#/$defs/registered"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["when"],
          "properties": {"when": {"$ref": "#/$defs/when"}}
        }
      ]
    },
    "when": {
      "description": "Every listed field of the triggering event must match.",
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
        "not": {"enum": ["event", "event_data", "machine", "model", "source", "state", "target", "transition"]}
      },
      "additionalProperties": {"$ref": "#/$defs/match"}
    },
    "match": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "additionalProperties": false,
      "properties": {
        "equals": {"$ref": "#/$defs/scalar"},
        "in": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scalar"}},
        "exists": {"type": "boolean"}
      }
    },
    "scalar": {"type": ["string", "number", "boolean"]}
  }
}
